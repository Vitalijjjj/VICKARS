---
/**
 * Floating "liquid glass" capsule header.
 *
 * Grouping:
 *  ≥1180px  logo · 4 primary sections · "More" (secondary sections) · UA/RU/EL · CTA
 *  721–1179 logo · UA/RU/EL · CTA · Menu (grouped sheet)
 *  ≤720px   logo · Menu (grouped sheet with language + CTA)
 *
 * Planned sections render as non-interactive items marked "soon" — no fake links.
 */
import { homeSectionsFor, booking, navGroups, navGroupLabel } from '@/config/site';
import { locales, localeLabel, localeName, localePath, useTranslations, type Locale } from '@/i18n/ui';

interface Props { locale: Locale; path?: string }
const { locale, path = '/' } = Astro.props;
const t = useTranslations(locale);
// home sections: a plain anchor on the home page, a link back home (then scrolled) from any other page
const onHome = path === '/';
const sectionHref = (id: string) => (onHome ? `#${id}` : `${localePath(locale, '/')}#${id}`);

const sections = homeSectionsFor(locale);
const primary = sections.filter((s) => s.primary);
const secondary = sections.filter((s) => !s.primary);
const grouped = navGroups.map((g) => ({ g, label: t(navGroupLabel[g]), items: sections.filter((s) => s.group === g) }));
const soon = t('state.soon');
import badge from '@/assets/brand/vikcars-badge.svg?raw';
---

<header class="lgh" data-lgh>
  <div class="lgh__capsule" data-lgh-capsule>
    <span class="lgh__glass" aria-hidden="true"><span class="lgh__shine"></span></span>
    <span class="lgh__pill" aria-hidden="true" data-lgh-pill></span>

    <a class="lgh__logo" href={localePath(locale, '/')} aria-label={t('nav.home')} data-lgh-hover>
      <span class="lgh__logo-badge" aria-hidden="true" set:html={badge} />
    </a>

    <nav class="lgh__nav" aria-label={t('nav.label')}>
      <ul class="lgh__primary">
        {primary.map((s) => (
          <li>
            {s.status === 'live' ? (
              <a class="lgh__link" href={sectionHref(s.id)} data-scroll-to={s.id} data-lgh-hover>
                <span class="lgh__roll" data-text={t(s.label)}><span>{t(s.label)}</span></span>
              </a>
            ) : (
              <span class="lgh__link is-planned" role="link" aria-disabled="true" tabindex="0" data-soon={soon} data-target={`#${s.id}`} data-lgh-hover>
                {t(s.label)}
              </span>
            )}
          </li>
        ))}
        <li class="lgh__more">
          <button class="lgh__link lgh__more-btn" type="button" aria-expanded="false" aria-controls="lgh-more" data-lgh-more data-lgh-hover>
            {t('nav.more')}
            <svg class="lgh__chev" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div class="lgh__drop" id="lgh-more" data-lgh-drop hidden>
            <span class="lgh__glass lgh__glass--dense" aria-hidden="true"></span>
            <ul>
              {secondary.map((s) => (
                <li>
                  {s.status === 'live' ? (
                    <a class="lgh__drop-item" href={sectionHref(s.id)} data-scroll-to={s.id}>{t(s.label)}</a>
                  ) : (
                    <span class="lgh__drop-item is-planned" role="link" aria-disabled="true" tabindex="0" data-target={`#${s.id}`}>
                      {t(s.label)}<em class="lgh__soon">{soon}</em>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </li>
      </ul>
    </nav>

    <div class="lgh__lang" role="group" aria-label={t('nav.language')}>
      {locales.map((l) => (
        <a class="lgh__lang-item" href={localePath(l, path)} hreflang={l} lang={l} aria-label={localeName[l]} aria-current={l === locale ? 'true' : undefined} data-lgh-hover>
          {localeLabel[l]}
        </a>
      ))}
    </div>

    {booking.status === 'live' ? (
      <a class="lgh__cta" href={sectionHref(booking.id)} data-scroll-to={booking.id}><span>{t('cta.book')}</span></a>
    ) : (
      <span class="lgh__cta" role="link" aria-disabled="true" tabindex="0" data-soon={soon} data-target={`#${booking.id}`}><span>{t('cta.book')}</span></span>
    )}

    <button class="lgh__burger" type="button" aria-expanded="false" aria-controls="lgh-sheet" data-lgh-burger>
      <span class="lgh__burger-label" data-open={t('nav.menu')} data-close={t('nav.close')}>{t('nav.menu')}</span>
      <span class="lgh__burger-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="lgh__sheet" id="lgh-sheet" data-lgh-sheet hidden>
    <span class="lgh__glass lgh__glass--dense" aria-hidden="true"></span>
    <nav class="lgh__sheet-nav" aria-label={t('nav.label')}>
      {grouped.map(({ g, label, items }) => (
        <div class="lgh__group" data-sheet-item>
          <p class="lgh__group-label mono">{label}</p>
          <ul>
            {items.map((s) => (
              <li>
                {s.status === 'live' ? (
                  <a class="lgh__sheet-link" href={sectionHref(s.id)} data-scroll-to={s.id}>{t(s.label)}</a>
                ) : (
                  <span class="lgh__sheet-link is-planned" role="link" aria-disabled="true" tabindex="0" data-target={`#${s.id}`}>
                    {t(s.label)}<em class="lgh__soon">{soon}</em>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <div class="lgh__sheet-foot" data-sheet-item>
      <div class="lgh__lang lgh__lang--sheet" role="group" aria-label={t('nav.language')}>
        {locales.map((l) => (
          <a class="lgh__lang-item" href={localePath(l, path)} hreflang={l} lang={l} aria-label={localeName[l]} aria-current={l === locale ? 'true' : undefined}>
            {localeLabel[l]}
          </a>
        ))}
      </div>
      <span class="lgh__cta lgh__cta--sheet" role="link" aria-disabled="true" tabindex="0" data-soon={soon}><span>{t('cta.book')}</span></span>
    </div>
  </div>

  <!-- Edge refraction filter (Chromium). The displacement map is generated for the capsule size at runtime. -->
  <svg class="lgh__defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="lgh-refract" x="0" y="0" width="100%" height="100%" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feImage data-lgh-map href="" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
      <feDisplacementMap in="SourceGraphic" in2="map" scale="26" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
</header>

<style>
  .lgh {
    --lgh-r: 14px;                          /* outer corners (capsule, dropdown) */
    --lgh-r-in: calc(var(--lgh-r) - 7px);   /* concentric inner items (capsule padding 7px) */
    position: fixed;
    inset: var(--header-top) 0 auto;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  /* ---------------------------------------------------------- capsule */
  .lgh__capsule {
    --pad: 7px;
    /* corners echo the VIK Cars badge: a soft, small radius — not a pill. Inner items stay concentric. */
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 6px;
    height: var(--header-h);
    padding: var(--pad);
    padding-left: 16px;
    border-radius: var(--lgh-r);
    pointer-events: auto;
    view-transition-name: site-header;   /* stays still while pages change underneath */
    transform: translateZ(0);
    transition: transform 0.6s var(--ease-out);
  }

  /* glass body — shared by capsule, dropdown and sheet */
  .lgh__glass {
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: inherit;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.74) 0%, rgb(255 255 255 / 0.58) 55%, rgb(255 255 255 / 0.66) 100%);
    /* frosted enough to read on any photo (dark interiors included); the refraction rim still shows the glass */
    -webkit-backdrop-filter: blur(18px) saturate(1.4) brightness(1.12);
    backdrop-filter: blur(18px) saturate(1.4) brightness(1.12);
    box-shadow:
      inset 0 1px 0.5px rgb(255 255 255 / 0.95),
      inset 0 -1px 0.5px rgb(255 255 255 / 0.45),
      inset 0 0 0 0.5px rgb(255 255 255 / 0.35),
      inset 0 -12px 18px -12px rgb(255 255 255 / 0.75),
      inset 0 10px 16px -14px rgb(60 48 30 / 0.12),
      0 1px 1px rgb(40 32 20 / 0.05),
      0 10px 28px -8px rgb(40 32 20 / 0.2),
      0 30px 60px -30px rgb(40 32 20 / 0.25);
    transition: background 0.5s var(--ease-out);
  }
  /* specular rim: bright where light hits (top-left / bottom-right), fading elsewhere */
  .lgh__glass::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(120deg, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.12) 32%, rgb(255 255 255 / 0) 55%, rgb(255 255 255 / 0.55) 88%, rgb(255 255 255 / 0.9));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    pointer-events: none;
  }
  /* soft lens highlight across the upper half */
  .lgh__glass::after {
    content: '';
    position: absolute;
    inset: 1px 12% 50% 12%;
    border-radius: inherit;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0));
    filter: blur(2px);
    opacity: 0.55;
    pointer-events: none;
  }
  :global(.lgh.is-refract) .lgh__capsule > .lgh__glass {
    -webkit-backdrop-filter: url(#lgh-refract) blur(14px) saturate(1.4) brightness(1.12);
    backdrop-filter: url(#lgh-refract) blur(14px) saturate(1.4) brightness(1.12);
  }
  :global(.lgh.is-scrolled) .lgh__capsule > .lgh__glass {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.82) 0%, rgb(255 255 255 / 0.68) 55%, rgb(255 255 255 / 0.74) 100%);
  }

  /* panels carry reading content: denser frosted glass so nothing behind competes with the text */
  .lgh__glass--dense {
    background: linear-gradient(180deg, rgb(253 250 245 / 0.9) 0%, rgb(250 245 238 / 0.84) 100%);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
    backdrop-filter: blur(24px) saturate(1.5);
  }

  /* cursor light */
  .lgh__shine {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(160px circle at var(--lx, 50%) var(--ly, 0%), rgb(255 255 255 / 0.65), rgb(255 255 255 / 0) 70%);
    opacity: var(--shine, 0);
    mix-blend-mode: overlay;
    transition: opacity 0.6s var(--ease-out);
  }

  /* hover pill that glides between items */
  .lgh__pill {
    position: absolute;
    top: var(--pad);
    left: 0;
    z-index: -1;
    height: calc(100% - var(--pad) * 2);
    width: 0;
    border-radius: var(--lgh-r-in);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.38));
    box-shadow:
      inset 0 1px 0.5px rgb(255 255 255 / 1),
      inset 0 -1px 0.5px rgb(255 255 255 / 0.5),
      0 2px 8px -2px rgb(40 32 20 / 0.14);
    opacity: 0;
    pointer-events: none;
    will-change: transform, width, opacity;
  }

  /* ---------------------------------------------------------- content */
  .lgh__logo {
    display: inline-flex;
    align-items: center;
    height: 100%;
    padding-inline: 8px 12px;
    border-radius: var(--lgh-r-in);
  }
  /* VIK Cars badge (vector from the brand PDF) — sized by height, ratio 130 : 100.7 */
  .lgh__logo-badge {
    display: block;
    height: 38px;
    aspect-ratio: 129.97 / 100.72;
    filter: drop-shadow(0 2px 3px rgb(120 18 24 / 0.22));
    transition: transform 0.6s var(--ease-spring);
  }
  .lgh__logo-badge :global(svg) { width: 100%; height: 100%; }
  .lgh__logo:hover .lgh__logo-badge { transform: translateY(-1px) rotate(-2deg); }

  .lgh__nav { height: 100%; }
  .lgh__primary { display: flex; align-items: center; height: 100%; gap: 2px; }
  .lgh__primary > li { height: 100%; }

  .lgh__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 100%;
    padding-inline: 14px;
    border-radius: var(--lgh-r-in);
    font-size: var(--fs-small);
    font-weight: 480;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color 0.4s var(--ease-out);
  }
  .lgh__link:hover, .lgh__link[aria-expanded='true'] { color: var(--ink); }

  /* text roll on live links */
  .lgh__roll { position: relative; display: inline-block; overflow: hidden; line-height: 1.25; }
  .lgh__roll > span { display: inline-block; transition: transform 0.55s var(--ease-out); }
  .lgh__roll::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    transition: transform 0.55s var(--ease-out);
  }
  .lgh__link:hover .lgh__roll > span,
  .lgh__link:hover .lgh__roll::after,
  .lgh__link:focus-visible .lgh__roll > span,
  .lgh__link:focus-visible .lgh__roll::after { transform: translateY(-100%); }

  /* planned items */
  .is-planned { color: rgb(27 26 23 / 0.58); }
  .lgh__link.is-planned:hover { color: var(--ink-2); }
  [data-soon] { position: relative; }
  [data-soon]::after {
    content: attr(data-soon);
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    padding: 5px 10px;
    border-radius: var(--lgh-r-in);
    background: rgb(27 26 23 / 0.86);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, -4px);
    transition: opacity 0.35s var(--ease-out), transform 0.45s var(--ease-out);
    pointer-events: none;
  }
  [data-soon]:hover::after, [data-soon]:focus-visible::after, [data-soon].is-poked::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .lgh__soon {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    opacity: 0.8;
  }

  .lgh__chev { width: 9px; height: 6px; transition: transform 0.5s var(--ease-out); }
  .lgh__more-btn[aria-expanded='true'] .lgh__chev { transform: rotate(180deg); }
  .lgh__more { position: relative; }

  /* dropdown */
  .lgh__drop {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    min-width: 220px;
    padding: 8px;
    border-radius: var(--lgh-r);
    isolation: isolate;
    /* horizontal centring is applied by GSAP (xPercent: -50) */
  }
  .lgh__drop-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 11px 14px;
    border-radius: calc(var(--lgh-r) - 6px);
    font-size: var(--fs-small);
    color: var(--ink-2);
  }
  .lgh__drop-item:not(.is-planned):hover { background: rgb(255 255 255 / 0.5); color: var(--ink); }

  /* language */
  .lgh__lang {
    display: flex;
    align-items: center;
    height: calc(100% - 6px);
    padding: 3px;
    margin-left: 4px;
    border-radius: calc(var(--lgh-r-in) + 3px);
    background: rgb(27 26 23 / 0.045);
    box-shadow: inset 0 1px 2px rgb(27 26 23 / 0.06), inset 0 -1px 0 rgb(255 255 255 / 0.6);
  }
  .lgh__lang-item {
    display: grid;
    place-items: center;
    height: 100%;
    min-width: 34px;
    padding-inline: 8px;
    border-radius: var(--lgh-r-in);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 560;
    letter-spacing: var(--tracking);
    color: rgb(27 26 23 / 0.58);
    transition: color 0.35s var(--ease-out), background 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }
  .lgh__lang-item:hover { color: var(--ink); }
  .lgh__lang-item[aria-current='true'] {
    color: var(--ink);
    background: rgb(255 255 255 / 0.85);
    box-shadow: 0 1px 3px rgb(40 32 20 / 0.12), inset 0 1px 0 #fff;
  }

  /* CTA */
  .lgh__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 100%;
    margin-left: 4px;
    padding-inline: 20px;
    border-radius: var(--lgh-r-in);
    background: linear-gradient(180deg, var(--accent), var(--accent-deep));
    color: #fff;
    font-size: var(--fs-small);
    font-weight: 520;
    letter-spacing: var(--tracking);
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      inset 0 -1px 0 rgb(90 10 16 / 0.35),
      0 6px 16px -6px rgb(var(--accent-rgb) / 0.55);
    transition: transform 0.5s var(--ease-spring), box-shadow 0.5s var(--ease-out);
  }
  /* light sweep — animated via background-position so it never leaves the pill */
  .lgh__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(105deg, transparent 40%, rgb(255 255 255 / 0.2) 50%, transparent 60%) no-repeat;
    background-size: 300% 100%;
    background-position: 100% 0;
    transition: background-position 1s var(--ease-out);
  }
  .lgh__cta:hover { transform: translateY(-1px); }
  .lgh__cta:hover::before { background-position: 0% 0; }
  .lgh__cta[data-soon]::after { background: var(--paper); color: var(--ink); box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.2); }
  .lgh__cta > span { position: relative; }

  /* burger */
  .lgh__burger {
    display: none;
    align-items: center;
    gap: 10px;
    height: 100%;
    margin-left: 4px;
    padding-inline: 16px 14px;
    border-radius: var(--lgh-r-in);
    background: rgb(255 255 255 / 0.55);
    box-shadow: inset 0 1px 0 #fff, 0 1px 3px rgb(40 32 20 / 0.1);
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .lgh__burger-icon { position: relative; width: 16px; height: 10px; }
  .lgh__burger-icon i {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.3px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.55s var(--ease-out), top 0.55s var(--ease-out);
  }
  .lgh__burger-icon i:first-child { top: 1px; }
  .lgh__burger-icon i:last-child { top: 8px; }
  .lgh__burger[aria-expanded='true'] .lgh__burger-icon i:first-child { top: 4.5px; transform: rotate(45deg); }
  .lgh__burger[aria-expanded='true'] .lgh__burger-icon i:last-child { top: 4.5px; transform: rotate(-45deg); }

  /* sheet (tablet / mobile) */
  .lgh__sheet {
    position: relative;
    isolation: isolate;
    width: min(560px, 100%);
    margin-top: 10px;
    padding: 22px 22px 18px;
    border-radius: calc(var(--lgh-r) + 4px);
    pointer-events: auto;
    transform-origin: 50% 0;
  }
  .lgh__sheet-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 18px; }
  .lgh__group-label { margin-bottom: 8px; color: var(--ink-3); text-transform: uppercase; }
  .lgh__sheet-link {
    display: flex;
    align-items: baseline;
    padding: 7px 0;
    font-size: 1.125rem;
    font-weight: 460;
    letter-spacing: var(--tracking-tight);
  }
  .lgh__sheet-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    height: calc(46px + 17px);
  }
  .lgh__lang--sheet { margin: 0; height: 40px; }
  .lgh__cta--sheet { height: 46px; margin: 0; }
  .lgh__cta--sheet[data-soon]::after { top: auto; bottom: calc(100% + 10px); }

  .lgh__defs { position: absolute; }

  /* ---------------------------------------------------------- breakpoints */
  .lgh__sheet .lgh__lang--sheet, .lgh__sheet .lgh__cta--sheet { display: inline-flex; }

  @media (max-width: 1179px) {
    .lgh__nav { display: none; }
    .lgh__burger { display: inline-flex; }
  }
  @media (min-width: 1180px) {
    .lgh__sheet { display: none !important; }
  }
  @media (max-width: 720px) {
    .lgh__capsule { width: 100%; justify-content: space-between; padding-left: 10px; }
    .lgh__capsule > .lgh__lang, .lgh__capsule > .lgh__cta { display: none; }
    .lgh__logo { padding-inline: 2px 8px; }
    .lgh__logo-badge { height: 34px; }
    .lgh__sheet { width: 100%; padding: 20px 18px 16px; }
    .lgh__sheet-nav { grid-template-columns: 1fr; gap: 16px; }
    .lgh__group { display: grid; grid-template-columns: 96px 1fr; align-items: baseline; }
    .lgh__group-label { margin: 0; }
    .lgh__sheet-link { padding: 5px 0; font-size: 1.0625rem; }
  }
  @media (hover: none) {
    [data-soon]:hover::after { opacity: 0; }
    [data-soon].is-poked::after { opacity: 1; }
  }
</style>

<script>
  import { initLiquidGlassHeader } from '@/scripts/header';
  initLiquidGlassHeader();
</script>
