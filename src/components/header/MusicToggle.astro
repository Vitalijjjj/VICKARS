---
/**
 * Music toggle for the header. Plays a YouTube track through the official IFrame Player API, started only by the
 * visitor's click (browsers block autoplay with sound). YouTube's terms don't allow a hidden player, so while music
 * plays a tiny glass mini-player (200×200, YouTube's minimum) sits in the bottom-right corner with a close button.
 * NOTE: for a business site the track needs the rights holder's licence.
 */
interface Props { videoId?: string; title?: string }
const { videoId = 'bV6R9zTKySg', title = 'Drevo — Smaragdove Nebo (Mylancore Remix)' } = Astro.props;
---

<button class="mt" type="button" aria-pressed="false" aria-label="Увімкнути музику" title="Музика" data-mt data-video={videoId}>
  <span class="mt__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
</button>

<div class="mt-player" data-mt-player hidden>
  <div class="mt-player__head">
    <span class="mt-player__eq" aria-hidden="true"><i></i><i></i><i></i></span>
    <p><b>Зараз грає</b><span>{title}</span></p>
    <button type="button" class="mt-player__x" data-mt-close aria-label="Вимкнути музику">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    </button>
  </div>
  <div class="mt-player__frame"><div data-mt-frame></div></div>
</div>

<style>
  .mt { position: relative; display: grid; place-items: center; width: 38px; height: 38px; flex: none; border: 0; border-radius: 999px; cursor: pointer; color: var(--ink); background: rgb(255 255 255 / 0.55); box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08); transition: background 0.3s, color 0.3s; }
  .mt:hover { background: #fff; }
  .mt[aria-pressed='true'] { color: #fff; background: var(--accent); box-shadow: 0 6px 16px rgb(229 37 50 / 0.35); }
  .mt__bars { display: flex; align-items: flex-end; gap: 2px; height: 14px; }
  .mt__bars i { width: 2.5px; height: 4px; border-radius: 2px; background: currentColor; transition: height 0.3s; }
  .mt__bars i:nth-child(2) { height: 9px; } .mt__bars i:nth-child(3) { height: 6px; } .mt__bars i:nth-child(4) { height: 11px; }
  .mt[aria-pressed='true'] .mt__bars i { animation: mt-eq 0.9s ease-in-out infinite; }
  .mt[aria-pressed='true'] .mt__bars i:nth-child(2) { animation-delay: -0.3s; }
  .mt[aria-pressed='true'] .mt__bars i:nth-child(3) { animation-delay: -0.6s; }
  .mt[aria-pressed='true'] .mt__bars i:nth-child(4) { animation-delay: -0.15s; }
  @keyframes mt-eq { 0%, 100% { height: 3px; } 50% { height: 14px; } }

  .mt-player { position: fixed; z-index: 60; right: 12px; bottom: 12px; width: 212px; display: grid; gap: 6px; padding: 6px; border-radius: 16px; color: #fff; background: rgb(29 24 21 / 0.8); backdrop-filter: blur(20px) saturate(1.4); -webkit-backdrop-filter: blur(20px) saturate(1.4); box-shadow: inset 0 0 0 1px rgb(244 230 216 / 0.14), 0 24px 60px rgb(0 0 0 / 0.45); animation: mt-in 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
  .mt-player[hidden] { display: none; }
  @keyframes mt-in { from { opacity: 0; transform: translateY(24px) scale(0.96); } }
  .mt-player__head { display: flex; align-items: center; gap: 8px; padding: 2px 2px 0 6px; }
  .mt-player__head p { margin: 0; display: grid; min-width: 0; flex: 1; font-size: 11px; line-height: 1.25; }
  .mt-player__head b { font-size: 9px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: rgb(244 230 216 / 0.6); }
  .mt-player__head span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mt-player__eq { display: flex; align-items: flex-end; gap: 2px; height: 14px; color: var(--accent); }
  .mt-player__eq i { width: 3px; border-radius: 2px; background: currentColor; animation: mt-eq 0.9s ease-in-out infinite; }
  .mt-player__eq i:nth-child(2) { animation-delay: -0.4s; } .mt-player__eq i:nth-child(3) { animation-delay: -0.2s; }
  .mt-player__x { display: grid; place-items: center; width: 26px; height: 26px; flex: none; border: 0; border-radius: 50%; cursor: pointer; color: #fff; background: rgb(255 255 255 / 0.1); }
  .mt-player__x:hover { background: var(--accent); }
  .mt-player__x svg { width: 13px; height: 13px; }
  /* 200×200 is YouTube's minimum player viewport — smaller embeds may refuse to play */
  .mt-player__frame { width: 200px; height: 200px; border-radius: 11px; overflow: hidden; background: #000; }
  .mt-player__frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  @media (max-width: 720px) { .mt { margin-left: auto; margin-right: 6px; } }
  @media (prefers-reduced-motion: reduce) { .mt__bars i, .mt-player__eq i { animation: none !important; } }
</style>

<script>
  type YTPlayer = { playVideo(): void; pauseVideo(): void };
  type YTNs = { Player: new (el: HTMLElement, o: object) => YTPlayer };
  const w = window as unknown as { YT?: YTNs; onYouTubeIframeAPIReady?: () => void };

  const btn = document.querySelector<HTMLButtonElement>('[data-mt]');
  const box = document.querySelector<HTMLElement>('[data-mt-player]');
  if (btn && box) {
    document.body.append(box);   // out of the header: its backdrop-filter would trap position:fixed
    const videoId = btn.dataset.video!;
    let player: YTPlayer | null = null, playing = false, loading: Promise<void> | null = null;
    const setUi = (on: boolean) => {
      playing = on;
      btn.setAttribute('aria-pressed', String(on)); btn.setAttribute('aria-label', on ? 'Вимкнути музику' : 'Увімкнути музику');
      box.hidden = !on;
    };
    const loadApi = () => loading ??= new Promise<void>((res) => {
      if (w.YT?.Player) return res();
      const prev = w.onYouTubeIframeAPIReady;
      w.onYouTubeIframeAPIReady = () => { prev?.(); res(); };
      const s = document.createElement('script'); s.src = 'https://www.youtube.com/iframe_api'; document.head.append(s);
    });
    const start = async () => {
      setUi(true);
      if (player) { player.playVideo(); return; }
      await loadApi();
      player = new w.YT!.Player(box.querySelector<HTMLElement>('[data-mt-frame]')!, {
        videoId, width: 200, height: 200,
        playerVars: { autoplay: 1, loop: 1, playlist: videoId, controls: 1, rel: 0, playsinline: 1, modestbranding: 1 },
        events: { onReady: (e: { target: YTPlayer }) => e.target.playVideo() },
      });
    };
    const stop = () => { player?.pauseVideo(); setUi(false); };
    btn.addEventListener('click', () => (playing ? stop() : start()));
    box.querySelector('[data-mt-close]')!.addEventListener('click', stop);
  }
</script>
