---
/** Site footer (all pages): dark, quick booking by phone, nav, embossed wordmark. */
import badge from '@/assets/brand/vikcars-badge.svg?raw';
import { homeSectionsFor } from '@/config/site';
import { business } from '@/config/business';
import { homeCopy } from '@/i18n/home';
import { locales, localeLabel, localePath, useTranslations, type Locale } from '@/i18n/ui';

interface Props { locale: Locale; path?: string }
const { locale, path = '/' } = Astro.props;
const t = useTranslations(locale);
const f = homeCopy[locale].footer;
const home = localePath(locale, '/');
const onHome = path === '/';
const tel = business.phone ? `tel:${business.phone.replace(/\s/g, '')}` : null;
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="ft__top">
    <div>
      <p class="ft__label">{f.book}</p>
      <form class="ft__form" data-ft-form novalidate>
        <input name="phone" type="tel" placeholder={f.phone} aria-label={f.phone} autocomplete="tel" required />
        <button type="submit">{f.send}</button>
      </form>
      <p class="ft__sent" data-ft-sent hidden>{f.sent}</p>
    </div>
    <a class="ft__badge" href={home} aria-label={t('nav.home')} set:html={badge} />
    <nav class="ft__nav" aria-label={t('nav.label')}>
      {homeSectionsFor(locale).filter((s) => s.status === 'live').map((s) => (
        <a href={onHome ? `#${s.id}` : `${home}#${s.id}`} data-scroll-to={onHome ? s.id : undefined}>{t(s.label)}</a>
      ))}
    </nav>
  </div>
  <p class="ft__mark" aria-hidden="true">VIK CARS</p>
  <div class="ft__bar">
    <span>© {year} VIK Cars · {f.city} · {f.rights}</span>
    {tel && <a href={tel}>{business.phone}</a>}
    <span class="ft__lang">{locales.map((l) => <a href={localePath(l, path)} hreflang={l} aria-current={l === locale ? 'true' : undefined}>{localeLabel[l]}</a>)}</span>
  </div>
</footer>

<style>
  .ft { position: relative; z-index: 1; }
  .ft__label { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(255 255 255 / 0.85); }
  .ft__form { display: flex; gap: 8px; margin-top: 12px; }
  .ft__form input { width: 280px; padding: 15px 16px; font: inherit; font-size: 16px; color: #fff; background: transparent; border: 1px solid rgb(255 255 255 / 0.25); border-radius: 6px; }
  .ft__form input:focus { outline: none; border-color: #fff; }
  .ft__form input[aria-invalid='true'] { border-color: var(--accent); }
  .ft__form button { padding: 0 20px; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #0f0f0f; background: #fff; border-radius: 6px; transition: background 0.3s, color 0.3s; }
  .ft__form button:hover { background: var(--accent); color: #fff; }
  .ft__sent { margin-top: 12px; font-size: 16px; color: rgb(255 255 255 / 0.7); }
  .ft__sent[hidden] { display: none; }
  .ft__badge { display: block; width: 64px; }
  .ft__badge :global(svg) { width: 100%; height: auto; }
  .ft__nav { display: grid; justify-items: end; gap: 10px; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
  .ft__nav a:hover, .ft__bar a:hover { color: #fff; }
  .ft__lang { display: flex; gap: 10px; }
  .ft__lang a[aria-current='true'] { color: #fff; }
  /* ---------------------------------------------------------- footer */
  .ft { background: #0d0d0d; color: rgb(255 255 255 / 0.8); padding: 56px var(--gutter) 28px; overflow: hidden; }
  .ft__top { display: grid; grid-template-columns: 1fr auto 1fr; align-items: start; gap: 24px; }
  .ft__mark {
    margin: clamp(48px, 8vw, 120px) 0 clamp(24px, 4vw, 48px);
    text-align: center; font-size: clamp(5rem, 1rem + 15vw, 17rem); font-weight: 700; letter-spacing: -0.06em; line-height: 0.8;
    color: #0d0d0d; text-shadow: -1px -1px 0 rgb(255 255 255 / 0.07), 1px 1px 0 rgb(0 0 0 / 0.9), 0 0 1px rgb(255 255 255 / 0.05);
    background: linear-gradient(180deg, #171717, #0b0b0b); -webkit-background-clip: text; background-clip: text;
  }
  .ft__bar { display: flex; justify-content: space-between; gap: 16px; padding-top: 18px; border-top: 1px solid rgb(255 255 255 / 0.1); font-size: 12.5px; letter-spacing: 0.05em; text-transform: uppercase; color: rgb(255 255 255 / 0.45); }


  @media (max-width: 900px) {
    .ft__top { grid-template-columns: 1fr; }
    .ft__nav { justify-items: start; }
    .ft__bar { flex-direction: column; }
    .ft__form input { width: 100%; }
  }
</style>

<script>
  import { scrollToSection } from '@/scripts/navigation';
  document.querySelectorAll<HTMLAnchorElement>('.ft a[data-scroll-to]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); scrollToSection(a.dataset.scrollTo!); }));
  const form = document.querySelector<HTMLFormElement>('[data-ft-form]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = form.querySelector('input')!;
    const bad = !input.value.trim();
    input.setAttribute('aria-invalid', String(bad));
    if (bad) { input.focus(); return; }
    form.hidden = true;
    document.querySelector<HTMLElement>('[data-ft-sent]')!.hidden = false;
  });
</script>
