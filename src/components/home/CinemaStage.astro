  .cinema__veil i:nth-child(1) { --b: 1px; --s: 0%; --e: 35%; }
  .cinema__veil i:nth-child(2) { --b: 3px; --s: 20%; --e: 60%; }
  .cinema__veil i:nth-child(3) { --b: 7px; --s: 45%; --e: 85%; }
  .cinema__veil i:nth-child(4) { --b: 14px; --s: 70%; --e: 100%; }
  /* a breath of shade so light type sits on the asphalt */
  .cinema__veil::after {
    content: '';
    position: absolute;
