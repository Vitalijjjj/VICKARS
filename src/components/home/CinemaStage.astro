---
/**
 * BLOCK 01 (Cinematic Hero) + BLOCK 02 (Interactive Building) — one continuous pinned stage.
 *
 * The intro video and the approved render share one frame whose aspect ratio is exactly the render's
 * (1633×963). The video is 1634×964 (+1 px right/bottom for H.264) and is sized so that extra pixel
 * falls outside the frame — every other pixel lands exactly where the render's pixel is.
 * All interactive zones are SVG/HTML layered over the render, in render-pixel coordinates.
 */
import { RENDER, VIDEO, WORD, DEPTH, BUILDING, MARKERS, XRAY, MOBILE_PLATE, levels } from '@/config/building';
import { useTranslations, localePath, type Locale } from '@/i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const pct = (v: number, of: number) => `${(v / of) * 100}%`;
const levelData = levels.map((l) => ({
  id: l.id,
  code: l.code,
  name: l.name,
  text: t(l.text),
  page: localePath(locale, l.page),
  image: l.image,
  window: l.window,
  move: l.move,
}));
// overscanned layer images (W+2M × H+2M) positioned so their centre M..M+W/H lines up with the frame
const depthStyle = [
  `--d-l:${(-DEPTH.overscan / RENDER.width) * 100}%`,
  `--d-t:${(-DEPTH.overscan / RENDER.height) * 100}%`,
  `--d-w:${((RENDER.width + 2 * DEPTH.overscan) / RENDER.width) * 100}%`,
  `--d-h:${((RENDER.height + 2 * DEPTH.overscan) / RENDER.height) * 100}%`,
].join(';');
---

<section class="cinema" id="hero" aria-label={t('hero.label')} data-cinema>
  <div class="cinema__pin" data-pin>
    <div class="cinema__camera" data-camera>
      <!-- tall viewports: 9:16 plate under the frame (same pixels in the band), so the hero fills the screen;
           the portrait intro video is moved in here by cinema.ts. Positioned in render pixels by layout(). -->
      <div class="cinema__underlay" data-underlay aria-hidden="true">
        <img src={MOBILE_PLATE.src} width={MOBILE_PLATE.w} height={MOBILE_PLATE.h} alt="" loading="lazy" decoding="async" data-underlay-still />
      </div>
      <div class="cinema__frame" data-frame style={`--iw:${RENDER.width};--ih:${RENDER.height};--vw:${VIDEO.width};--vh:${VIDEO.height}`}>
        <!-- plate = approved still (handoff / fallback) + depth stack that reproduces it pixel-for-pixel at rest:
             sky → DETAILING → scene (building, ground, hills) → near (road, tree). Layers carry a mirrored overscan
             so a mouse-parallax shift never shows an edge. Built by materials/working/build_depth_layers.py. -->
        <div class="cinema__plate" data-still>
          <img
            class="cinema__still"
            src="/media/vikcars-render-v3-1.png"
            width={RENDER.width}
            height={RENDER.height}
            alt={t('hero.alt')}
            decoding="async"
            fetchpriority="high"
          />
          <div class="depth" data-depth-stack aria-hidden="true" style={depthStyle}>
            <div class="depth__layer" data-depth="sky"><img class="depth__img" src="/media/depth-sky-v3-1.webp" alt="" decoding="async" /></div>
            <div class="depth__layer" data-depth="word">
              <svg class="cinema__word" viewBox={`0 0 ${RENDER.width} ${RENDER.height}`} preserveAspectRatio="none" aria-hidden="true" data-word>
                <defs>
                  <!-- cap top → baseline: white that settles into the pale sky near the roof (Inter cap height ≈ 0.73em) -->
                  <linearGradient id="word-fill" gradientUnits="userSpaceOnUse" x1="0" y1={WORD.baseline - WORD.size * 0.73} x2="0" y2={WORD.baseline}>
                    <stop offset="0" stop-color="#ffffff" stop-opacity="0.96" />
                    <stop offset="0.45" stop-color="#f7fbff" stop-opacity="0.94" />
                    <stop offset="1" stop-color="#cfe1f6" stop-opacity="0.9" />
                  </linearGradient>
                </defs>
                <g data-word-inner>
                  <text x={WORD.x} y={WORD.baseline} font-size={WORD.size} text-anchor="middle" textLength={WORD.w} lengthAdjust="spacingAndGlyphs" fill="url(#word-fill)">{WORD.text}</text>
                </g>
              </svg>
            </div>
            <div class="depth__layer" data-depth="scene"><img class="depth__img" src="/media/depth-scene-v3-1.webp" alt="" decoding="async" /></div>
            <div class="depth__layer" data-depth="near"><img class="depth__img" src="/media/depth-near-v3-1.webp" alt="" decoding="async" /></div>
          </div>
        </div>
        <video
          class="cinema__video"
          muted
          playsinline
          preload="auto"
          disablepictureinpicture
          disableRemotePlayback
          aria-hidden="true"
          tabindex="-1"
          data-video
          data-handoff={VIDEO.handoffAt}
        >
          <source src={MOBILE_PLATE.video} type="video/mp4" media={MOBILE_PLATE.media} />
          <source src="/media/vikcars-intro-v3-3.mp4" type="video/mp4" />
        </video>

        <!-- −01: X-ray of the underground car park, revealed while the level is hovered / selected -->
        <img
          class="cinema__xray"
          src={XRAY.src}
          alt=""
          aria-hidden="true"
          decoding="async"
          loading="lazy"
          style={`left:${pct(XRAY.x, RENDER.width)};top:${pct(XRAY.y, RENDER.height)};width:${pct(XRAY.w, RENDER.width)};height:${pct(XRAY.h, RENDER.height)}`}
        />

        <!-- level zones (visual only), in render pixels -->
        <svg class="cinema__zones" viewBox={`0 0 ${RENDER.width} ${RENDER.height}`} preserveAspectRatio="none" aria-hidden="true" data-zones>
          {levels.map((l) =>
            l.zone ? (
              <g class="zone" data-zone={l.id}>
                <rect class="zone__fill" x={l.zone.x} y={l.zone.y} width={l.zone.w} height={l.zone.h} rx={l.zone.r} />
                <rect class="zone__line" x={l.zone.x} y={l.zone.y} width={l.zone.w} height={l.zone.h} rx={l.zone.r} pathLength="1" />
                <rect class="zone__scan" x={l.zone.x} y={l.zone.y} width={l.zone.w} height={l.zone.h} rx={l.zone.r} pathLength="1" />
              </g>
            ) : (
              <g class="zone zone--below" data-zone={l.id}>
                <line class="zone__ground" x1={BUILDING.x} y1={BUILDING.base} x2={BUILDING.x + BUILDING.w} y2={BUILDING.base} pathLength="1" />
                <line class="zone__drop" x1={l.marker!.x} y1={BUILDING.base} x2={l.marker!.x} y2={l.marker!.y - 14} pathLength="1" />
              </g>
            ),
          )}
        </svg>

        <!-- pointer hit areas over the facade (mouse/touch only; keyboard uses the markers below) -->
        <div class="cinema__hits" data-hits>
          {levels.filter((l) => l.zone).map((l) => (
            <span
              class="hit"
              data-hit={l.id}
              style={`left:${pct(l.zone!.x, RENDER.width)};top:${pct(l.zone!.y, RENDER.height)};width:${pct(l.zone!.w, RENDER.width)};height:${pct(l.zone!.h, RENDER.height)}`}
            ></span>
          ))}
        </div>

        <!-- level markers: placed on the clean concrete volume (right) and the pavement for −01 -->
        <div class="cinema__markers" data-markers>
          {levels.map((l) => {
            const pos = l.id === 'down1' ? { x: l.marker!.x, y: l.marker!.y } : MARKERS[l.id];
            return (
              <button
                type="button"
                class={`marker marker--${l.id}`}
                style={`left:${pct(pos.x, RENDER.width)};top:${pct(pos.y, RENDER.height)}`}
                data-level={l.id}
                aria-pressed="false"
                aria-label={`LEVEL ${l.code} — ${l.name}. ${t(l.text)}`}
              >
                <span class="marker__dot" aria-hidden="true"></span>
                <span class="marker__txt" aria-hidden="true">
                  <span class="marker__code">{l.code}</span>
                  <span class="marker__name">{l.name}</span>
                </span>
                <svg class="marker__go" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
            );
          })}
        </div>
      </div>
    </div>

    <!-- BLOCK 01 UI -->
    <!-- progressive blur over the road: stacked backdrop blurs, each faded in lower than the last.
         Kept outside .cinema__ui on purpose: an ancestor fading via opacity cuts backdrop-filter off at once,
         so the veil fades by shrinking its own blur radius (--veil-in on reveal, --veil-out on scroll). -->
    <div class="cinema__veil" aria-hidden="true" data-veil><i></i><i></i><i></i><i></i></div>

    <div class="cinema__ui">

      <!-- hero foot — editorial line: brand · scroll (a glass node on the line) · what comes next -->
      <div class="foot">
        <p class="foot__brand">
          <span class="foot__name">VIK Cars</span>
          <span class="foot__meta">{t('hero.caption')}</span>
        </p>
        <a class="foot__scroll" href="#complex" data-scroll-to="complex" aria-label={t('hero.scroll')}>
          <span class="foot__ring" aria-hidden="true"><span class="foot__arrow"><svg viewBox="0 0 16 16"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg></span></span>
          <span class="foot__hint" aria-hidden="true">{t('hero.scroll')}</span>
        </a>
        <!-- what comes next: the three levels as a mini section of the building; each row jumps to its level -->
        <nav class="foot__next" aria-label={t('levels.title')}>
          <span class="foot__label">{t('levels.title')}<svg class="foot__go" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 3l6 6M9 4v5H4" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
          <ul class="foot__levels">
            {levels.map((l) => (
              <li>
                <a class="foot__level" href="#complex" data-goto-level={l.id} aria-label={`${l.code} — ${t(l.text)}`}>
                  <b>{l.code}</b>{t(`level.${l.id}.short` as const)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <!-- BLOCK 02 — Interactive building -->
    <section class="levels" id="complex" aria-labelledby="levels-title" data-levels>
      <p class="levels__title mono" id="levels-title" data-levels-title>
        <span>{t('levels.title')}</span><span class="levels__hint">— {t('levels.hint')}</span>
      </p>

      <!-- compact selector for touch / narrow screens -->
      <div class="levels__switch" role="group" aria-label={t('levels.title')} data-switch>
        {levels.map((l) => (
          <button type="button" class="levels__opt" data-level={l.id} aria-pressed="false">
            <span class="mono">{l.code}</span>
            <span class="levels__opt-name">{l.name}</span>
          </button>
        ))}
      </div>

      <aside class="preview" data-preview hidden aria-live="polite" aria-labelledby="preview-name">
        <span class="preview__glass" aria-hidden="true"></span>
        <p class="preview__code mono">LEVEL <span data-p-code></span></p>
        <h2 class="preview__name" id="preview-name" data-p-name></h2>
        <p class="preview__text" data-p-text></p>
        <a class="preview__go" href="#complex" data-p-go>
          <span>{t('levels.open')}</span>
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6h7M6.5 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <button type="button" class="preview__close" aria-label={t('levels.close')} data-p-close>
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
        </button>
      </aside>
    </section>
  </div>
</section>

<!-- building → level transition: a fixed "window" that opens into the level interior (scripts/cinema.ts → goToLevel) -->
<div class="lvt" data-lvt aria-hidden="true" hidden>
  <div class="lvt__win" data-lvt-win>
    <img class="lvt__img" data-lvt-img alt="" decoding="async" />
    <div class="lvt__doors" data-lvt-doors></div>
    <i class="lvt__glare" data-lvt-glare></i>
  </div>
  <p class="lvt__title" data-lvt-title><span data-lvt-code></span><span data-lvt-name></span></p>
</div>

<script type="application/json" id="levels-data" set:html={JSON.stringify(levelData)} />

<noscript>
  <style>
    .cinema__video { display: none; }
    .cinema__plate { opacity: 1 !important; }
  </style>
</noscript>

<style>
  @property --veil-in { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --veil-out { syntax: '<number>'; inherits: true; initial-value: 1; }

  .cinema { position: relative; }

  .cinema__pin {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--paper);
  }

  .cinema__camera {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    will-change: transform;
    --z: 1;
  }

  /* No-JS / pre-layout fallback: cover the viewport. JS replaces this with a safe-box aware fit. */
  .cinema__frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100vw, calc(100svh * var(--iw) / var(--ih)));
    aspect-ratio: 1633 / 963;
    transform: translate(-50%, -50%);
    overflow: hidden;
    background: var(--paper);
  }
  :global(.cinema.is-laid-out) .cinema__frame { transform: none; }
  /* fade frame edges into the paper when the frame is smaller than the viewport (tall screens) */
  :global(.cinema.is-contained) .cinema__frame {
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 13%, #000 87%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 13%, #000 87%, transparent 100%);
  }

  .cinema__still,
  .cinema__video {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    max-width: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  .cinema__still { width: 100%; height: 100%; }

  /* ---------------------------------------------------------- depth word */
  .cinema__plate { position: absolute; inset: 0; }
  .cinema__word {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    will-change: transform;
  }
  .cinema__word text {
    font-family: var(--font-sans);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }
  :global(html.js) .cinema__word [data-word-inner] { opacity: 0; }
  /* depth stack — hidden until all three layers are decoded, then it replaces the still (identical at rest) */
  .depth { position: absolute; inset: 0; }
  .depth__layer { position: absolute; inset: 0; }
  .depth__img {
    position: absolute;
    left: var(--d-l);
    top: var(--d-t);
    width: var(--d-w);
    height: var(--d-h);
    max-width: none;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  :global(html.js) .depth { visibility: hidden; }
  :global(html.js) .cinema__plate.is-depth-ready .depth { visibility: visible; }
  :global(html.js) .cinema__plate.is-depth-ready .cinema__still { visibility: hidden; }
  /* 1634×964 video: scale so 1 video px == 1 render px; the extra column/row is clipped by the frame */
  .cinema__video {
    width: calc(100% * var(--vw) / var(--iw));
    height: calc(100% * var(--vh) / var(--ih));
    object-fit: fill;
    background: var(--paper);
  }
  :global(html.js) .cinema__plate { opacity: 0; }

  /* ---------------------------------------------------------- portrait plate (tall viewports) */
  .cinema__underlay { position: absolute; left: 0; top: 0; display: none; overflow: hidden; background: var(--paper); }
  :global(.cinema.is-portrait) .cinema__underlay { display: block; }
  :global(.cinema.is-portrait) .cinema__frame { background: transparent; }
  .cinema__underlay > img,
  .cinema__underlay > .cinema__video { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; }
  :global(html.js) .cinema__underlay > img { opacity: 0; }

  /* ---------------------------------------------------------- building → level transition */
  .lvt { position: fixed; inset: 0; z-index: 40; pointer-events: none; }
  .lvt__win {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(var(--t, 50%) var(--r, 50%) var(--b, 50%) var(--l, 50%) round var(--rad, 6px));
    view-transition-name: level-window;
  }
  .lvt__img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; will-change: transform, filter; }
  .lvt__doors { position: absolute; inset: 0; }
  .lvt__doors i { position: absolute; left: 0; right: 0; background-repeat: no-repeat; will-change: transform; }
  .lvt__glare {
    position: absolute;
    inset: -20% -60%;
    background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.55) 48%, rgb(255 255 255 / 0.1) 54%, transparent 62%);
    opacity: 0;
    will-change: transform;
  }
  .lvt__title {
    position: absolute;
    margin: 0;
    display: grid;
    gap: 1px;
    width: max-content;
    color: var(--ink);
    view-transition-name: level-title;
  }
  .lvt__title span:first-child { font-size: 11px; font-weight: 600; color: var(--accent-deep); }
  .lvt__title span:last-child { font-size: 13.5px; font-weight: 560; letter-spacing: var(--tracking); }

  /* ---------------------------------------------------------- −01 x-ray */
  .cinema__xray {
    position: absolute;
    max-width: none;
    pointer-events: none;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    /* monochrome X-ray: reads as a technical section, not a second photo */
    filter: grayscale(1) contrast(1.12) brightness(1.04);
    transition: opacity 0.6s var(--ease-out), clip-path 0.9s var(--ease-out);
  }
  /* scans in from the ground line downwards */
  :global(.cinema.is-xray) .cinema__xray { opacity: 1; clip-path: inset(0 0 0 0); }

  /* ---------------------------------------------------------- zones */
  .cinema__zones {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    --sw: 1.4;
  }
  .zone__fill {
    fill: rgb(255 249 238);
    opacity: 0;
    mix-blend-mode: soft-light;
    transition: opacity 0.8s var(--ease-out);
  }
  .zone__line, .zone__ground, .zone__drop {
    fill: none;
    stroke: rgb(255 255 255 / 0.92);
    stroke-width: var(--sw);
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition: stroke-dashoffset 1.1s var(--ease-out), opacity 0.6s var(--ease-out);
  }
  .zone__ground { stroke-dasharray: 0.006 0.006; stroke-dashoffset: 0; }
  .zone.is-active .zone__fill { opacity: 0.55; }
  .zone.is-active .zone__line, .zone.is-active .zone__drop { opacity: 1; stroke-dashoffset: 0; }
  .zone.is-active .zone__ground { opacity: 1; }
  /* scan pass while the levels appear — driven by scroll, so no CSS transitions here */
  .zone__scan {
    fill: none;
    stroke: rgb(255 255 255 / 0.85);
    stroke-width: var(--sw);
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .cinema__hits { position: absolute; inset: 0; pointer-events: none; }
  .hit { position: absolute; cursor: pointer; border-radius: 12px; }
  :global(.cinema.is-interactive) .hit { pointer-events: auto; }

  /* ---------------------------------------------------------- markers */
  .cinema__markers { position: absolute; inset: 0; pointer-events: none; }
  /* level label: always open — dot · code over name · chevron; glass with the header's small corners */
  .marker {
    --s: calc(1 / var(--z));
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px 7px 8px;
    border-radius: 10px;
    transform: translate(0, -50%) scale(var(--s));
    transform-origin: 0 50%;
    color: var(--ink);
    text-align: left;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    isolation: isolate;
    transition: transform 0.5s var(--ease-out);
  }
  :global(.cinema.is-interactive) .marker { pointer-events: auto; }
  .marker::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.46));
    -webkit-backdrop-filter: blur(12px) saturate(1.6);
    backdrop-filter: blur(12px) saturate(1.6);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.95), inset 0 -1px 0 rgb(255 255 255 / 0.4), 0 8px 22px -10px rgb(30 24 14 / 0.4);
    transition: background 0.5s var(--ease-out);
  }
  .marker__dot {
    position: relative;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 4px rgb(27 26 23 / 0.08);
    transition: background 0.5s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }
  .marker__txt { display: grid; gap: 1px; line-height: 1.2; }
  .marker__code { font-size: 11px; font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums; letter-spacing: var(--tracking); }
  .marker__name { font-size: 13.5px; font-weight: 560; letter-spacing: var(--tracking); }
  .marker__go { width: 12px; height: 12px; color: var(--ink-3); transition: transform 0.5s var(--ease-out), color 0.4s var(--ease-out); }
  .marker:hover .marker__go, .marker.is-active .marker__go { transform: translateX(2px); color: var(--ink); }
  .marker.is-active::before, .marker:focus-visible::before { background: linear-gradient(180deg, rgb(255 255 255 / 0.94), rgb(255 255 255 / 0.74)); }
  .marker.is-active .marker__dot { background: var(--accent); box-shadow: 0 0 0 4px rgb(var(--accent-rgb) / 0.2); }
  .marker.is-active .marker__code { color: var(--accent-deep); }
  .marker.is-dim { opacity: 0.55 !important; }
  .marker:focus-visible { outline-offset: 2px; }

  /* ---------------------------------------------------------- hero UI */
  .cinema__ui { position: absolute; inset: 0; pointer-events: none; }
  /* Text that sits on the photograph (road / pavement) is light; on paper (contained layouts) it stays ink. */
  .levels__title {
    color: rgb(255 251 244 / 0.92);
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.35);
  }
  .levels__hint { color: rgb(255 251 244 / 0.66); }
  :global(.cinema.is-contained) .levels__title { color: var(--ink-2); text-shadow: none; }
  :global(.cinema.is-contained) .levels__hint { color: var(--ink-3); }

  /* ---------------------------------------------------------- hero bottom: progressive blur */
  .cinema__veil {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    pointer-events: none;
    --veil: calc(var(--veil-in) * var(--veil-out));
    transition: --veil-in 1.6s var(--ease-out);
  }
  .cinema__veil i {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(calc(var(--b) * var(--veil)));
    backdrop-filter: blur(calc(var(--b) * var(--veil)));
    -webkit-mask-image: linear-gradient(180deg, transparent var(--s), #000 var(--e));
