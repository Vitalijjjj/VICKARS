---
/**
 * Home sections below the building — layout after vonder.ai: quiet, centred, large neutral type, lots of air,
 * full-bleed photography, equal cards, a sticky feature list, detail rows and a rotating quote.
 * Inter Tight only. Copy: i18n/home.ts (draft for the client); facts: config/business.ts.
 * Section ids = config/site.ts → homeSections.
 */
import { business, type ServiceKey } from '@/config/business';
import { levels } from '@/config/building';
import { homeCopy } from '@/i18n/home';
import { localePath, type Locale } from '@/i18n/ui';
import badge from '@/assets/brand/vikcars-badge.svg?raw';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = homeCopy[locale];
const lv = (id: string) => levels.find((l) => l.id === id)!;
const tel = business.phone ? `tel:${business.phone.replace(/\s/g, '')}` : null;
const m = '/media/';
const services = Object.keys(business.prices) as ServiceKey[];
const accent = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
const floors = [
  { id: 'ground', code: '00', img: `${m}level-car-wash-v2-sm.webp` },
  { id: 'down1', code: '−01', img: `${m}level-detailing-studio-v2-sm.webp` },
  { id: 'up1', code: '+01', img: `${m}level-lounge-showroom-v2-s1-sm.webp` },
] as const;
const reel = ['level-car-wash-v2-s1', 'level-detailing-studio-v2-s1', 'level-lounge-showroom-v2', 'level-detailing-studio-v2-s3'].map((n) => `${m}${n}.webp`);
/** lead: every word a span (lights up on scroll); *…* runs become italic */
const words = (t: string) => t.trim().split(/\s+/).map((w) => `<span class="w">${w}</span>`).join(' ');
const leadHtml = c.statement.split(/(\*[^*]+\*)/).filter(Boolean).map((seg) => seg.startsWith('*') ? `<em>${words(seg.slice(1, -1))}</em>` : words(seg)).join(' ').replace(/ ([,.])/g, '$1');
const studioImgs = ['', '-s1', '-s2', '-s3'].map((s) => `${m}level-detailing-studio-v2${s}.webp`);
const stepImgs = [
  `${m}level-car-wash-v2-sm.webp`, `${m}level-lounge-showroom-v2-s1-sm.webp`, `${m}level-lounge-showroom-v2-s3-sm.webp`,
  `${m}level-car-wash-v2-s2-sm.webp`, `${m}level-detailing-studio-v2-s2-sm.webp`,
];
---

<div class="v2">
  <!-- about: giant staggered headline, italic lead, framed reel with the badge -->
  <section class="v2-about" data-about aria-labelledby="about-title">
    <p class="v2-label v2-about__label">{c.label}</p>
    <h2 class="v2-about__h" id="about-title" data-fit>
      <span class="v2-about__row v2-about__row--full">{c.about.full.split(' ').map((w) => <><span class="m"><span>{w}</span></span>{' '}<i class="v2-about__br" aria-hidden="true"></i></>)}</span>
      {c.about.pairs.map(([l, r]) => (
        <span class="v2-about__row v2-about__row--pair"><span class="m"><span>{l}</span></span>{' '}<span class="m m--r"><span>{r}</span></span>{' '}</span>
      ))}
    </h2>
    <p class="v2-about__txt" data-words set:html={leadHtml} />
    <a class="v2-under v2-about__cta" href="#booking" data-scroll-to="booking">{c.statementCta}</a>
    <figure class="v2-about__reel" data-reel aria-hidden="true">
      <div class="v2-about__frame">{reel.map((src, i) => <img class:list={{ 'is-on': i === 0 }} src={src} alt="" loading="lazy" decoding="async" />)}</div>
      <span class="v2-about__badge" set:html={badge} />
    </figure>
  </section>

  <!-- hand wash, full bleed -->
  <section class="v2-bleed" data-bleed>
    <img src={`${m}level-car-wash-v2-s1.webp`} alt="" loading="lazy" decoding="async" data-zoom />
    <div class="v2-bleed__txt">
      <h2 class="v2-h">{c.wash.title}</h2>
      <p>{c.wash.text}</p>
      <a class="v2-btn v2-btn--light" href="#booking" data-scroll-to="booking">{c.wash.cta}</a>
      {tel && <a class="v2-label v2-label--light" href={tel}>{business.phone}</a>}
    </div>
  </section>

  <!-- three floors -->
  <section class="v2-sec" id="services" aria-labelledby="services-title">
    <header class="v2-head" data-up>
      <h2 class="v2-h" id="services-title">{c.floors.title}</h2>
      <p class="v2-sub">{c.floors.sub}</p>
      <p class="v2-label">{c.floors.label}</p>
    </header>
    <ul class="v2-cards">
      {floors.map((f) => (
        <li data-up>
          <a href={localePath(locale, lv(f.id).page)}>
            <figure><img src={f.img} alt="" loading="lazy" decoding="async" /></figure>
            <p class="v2-label"><b>{f.code}</b> {c.floors.cards[f.id][0]}</p>
            <p class="v2-small">{c.floors.cards[f.id][1]}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- detailing studio: list drives a sticky image -->
  <section class="v2-sec v2-feature" data-feature aria-label={c.studio.label}>
    <div class="v2-feature__list">
      <p class="v2-label">{c.studio.label}</p>
      {c.studio.items.map(([t, d], i) => (
        <div class:list={['v2-feature__item', { 'is-on': i === 0 }]} data-feat={i}>
          <h3 class="v2-h">{t}</h3>
          <p class="v2-small">{d}</p>
        </div>
      ))}
    </div>
    <div class="v2-feature__media" aria-hidden="true">
      <ul class="v2-feature__thumbs">{studioImgs.map((src, i) => <li class:list={{ 'is-on': i === 0 }} data-thumb={i}><img src={src.replace('.webp', '-sm.webp')} alt="" loading="lazy" /></li>)}</ul>
      <figure class="v2-feature__img">{studioImgs.map((src, i) => <img class:list={{ 'is-on': i === 0 }} src={src} alt="" loading="lazy" data-feat-img={i} />)}</figure>
    </div>
  </section>

  <!-- lounge quote, full bleed -->
  <section class="v2-bleed v2-bleed--quote" data-bleed>
    <img src={`${m}level-lounge-showroom-v2.webp`} alt="" loading="lazy" decoding="async" data-zoom />
    <div class="v2-bleed__txt"><p class="v2-h v2-h--m">{c.loungeQuote}</p></div>
  </section>

  <!-- process -->
  <section class="v2-sec v2-rows" id="process" aria-labelledby="process-title">
    <h2 class="v2-h v2-rows__title" id="process-title" data-up>{c.process.title}</h2>
    <ol>
      {c.process.steps.map(([t, d], i) => (
        <li data-up>
          <span class="v2-rows__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="v2-h v2-h--s">{t}</h3>
          <p class="v2-small">{d}</p>
          <figure><img src={stepImgs[i]} alt="" loading="lazy" decoding="async" /></figure>
        </li>
      ))}
    </ol>
  </section>

  <!-- why VIK Cars: rotating quotes -->
  <section class="v2-quote" id="benefits" data-quotes aria-label={c.why.label}>
    <figure class="v2-quote__img"><img src={`${m}level-detailing-studio-v2-s1.webp`} alt="" loading="lazy" decoding="async" data-zoom /></figure>
    <div class="v2-quote__txt">
      <p class="v2-label">{c.why.label}</p>
      <div class="v2-quote__stack">
        {c.why.quotes.map(([q, s], i) => (
          <blockquote class:list={{ 'is-on': i === 0 }} data-q={i}>
            <p class="v2-h v2-h--m" set:html={`“${accent(q)}”`} />
            <cite class="v2-small">{s}</cite>
          </blockquote>
        ))}
      </div>
      <div class="v2-quote__dots">{c.why.quotes.map((_, i) => <button type="button" class:list={{ 'is-on': i === 0 }} data-dot={i} aria-label={`${i + 1}`}><i></i></button>)}</div>
    </div>
  </section>

  <!-- prices + booking -->
  <section class="v2-sec v2-prices" id="pricing" aria-labelledby="pricing-title">
    <header class="v2-head" data-up>
      <h2 class="v2-h" id="pricing-title">{c.prices.title}</h2>
      <p class="v2-sub">{c.prices.sub}</p>
    </header>
    <ul class="v2-prices__list">
      {services.map((k) => {
        const p = business.prices[k];
        return <li data-up><span class="v2-h v2-h--s">{c.prices.items[k][0]}</span><span class="v2-small">{c.prices.items[k][1]}</span><span class="v2-label">{p === null ? c.prices.onRequest : `${c.prices.from} €${p}`}</span></li>;
      })}
    </ul>
    <form class="v2-form" id="booking" data-booking novalidate data-up>
      <input name="name" placeholder={c.form.name} aria-label={c.form.name} autocomplete="name" required />
      <input name="phone" placeholder={c.form.phone} aria-label={c.form.phone} type="tel" autocomplete="tel" required />
      <select name="service" aria-label={c.form.service}>{services.map((k) => <option value={k}>{c.prices.items[k][0]}</option>)}</select>
      <button class="v2-btn" type="submit">{c.form.send}</button>
      <p class="v2-form__msg is-err" data-err hidden>{c.form.required}</p>
      <p class="v2-form__msg" data-done hidden>{c.form.sent}</p>
    </form>
    {tel && <p class="v2-label v2-center">{c.form.or} <a href={tel}>{c.form.call} {business.phone}</a></p>}
  </section>

  <!-- contacts, full bleed -->
  <section class="v2-bleed v2-bleed--end" id="contacts" data-bleed aria-labelledby="contacts-title">
    <img src={`${m}level-detailing-studio-v2-s2.webp`} alt="" loading="lazy" decoding="async" data-zoom />
    <div class="v2-bleed__txt">
      <h2 class="v2-h" id="contacts-title">{c.contacts.title}</h2>
      <p>{business.hours ? `${c.contacts.daily} ${business.hours}` : ''}{business.hoursPreliminary && ` · ${c.contacts.preliminary}`}</p>
      <div class="v2-row">
        {tel && <a class="v2-btn v2-btn--light" href={tel}>{c.contacts.call}</a>}
        {business.mapsUrl && <a class="v2-btn v2-btn--ghost" href={business.mapsUrl} target="_blank" rel="noopener">{c.contacts.route} ↗</a>}
      </div>
    </div>
  </section>
</div>

<style>
  .v2 { --bg: #fbf9f5; --ink9: #0f0f0f; background: var(--bg); color: var(--ink9); }
  .v2-sec { max-width: 1280px; margin: 0 auto; padding: clamp(80px, 10vw, 150px) var(--gutter); }

  /* ---------------------------------------------------------- type (Inter Tight, large + neutral) */
  .v2-h { font-size: clamp(2.3rem, 1.3rem + 3.2vw, 4.6rem); font-weight: 500; line-height: 1; letter-spacing: -0.05em; text-wrap: balance; }
  .v2-h--xl { font-size: clamp(2.5rem, 1.1rem + 4.6vw, 6.2rem); line-height: 1.02; }
  .v2-h--m { font-size: clamp(2rem, 1.2rem + 2.4vw, 3.6rem); line-height: 1.04; }
  .v2-h--s { font-size: clamp(1.45rem, 1.15rem + 0.9vw, 2.1rem); line-height: 1.1; letter-spacing: -0.035em; }
  .v2-h :global(em) { font-style: normal; color: var(--accent); }
  .v2-label { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .v2-label b { color: var(--accent); font-weight: 600; }
  .v2-label--light { color: rgb(255 255 255 / 0.85); }
  .v2-sub { font-size: clamp(17px, 15px + 0.35vw, 20px); line-height: 1.45; color: #4d4b46; max-width: 40ch; }
  .v2-small { font-size: clamp(16px, 15px + 0.2vw, 18px); line-height: 1.5; color: #4d4b46; }
  .v2-center { text-align: center; margin-top: 22px; color: #4d4b46; }
  .v2-center a { color: var(--ink9); border-bottom: 1px solid currentColor; }
  .v2-form__msg { grid-column: 1 / -1; font-size: 15px; color: var(--ink2, #5c5a55); }
  .v2-form__msg.is-err { color: var(--accent-deep); }
  .v2-form__msg[hidden] { display: none; }
  .v2-form [aria-invalid='true'] { border-color: var(--accent); }
  .v2-head { display: grid; justify-items: center; gap: 18px; text-align: center; margin-bottom: clamp(48px, 6vw, 88px); }

  .v2-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 16px 26px; border-radius: 10px; font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    background: var(--ink9); color: #fff; border: 1px solid transparent; transition: background 0.4s, color 0.4s;
  }
  .v2-btn:hover { background: var(--accent); }
  .v2-btn--light { background: #fff; color: var(--ink9); }
  .v2-btn--light:hover { background: var(--accent); color: #fff; }
  .v2-btn--ghost { background: transparent; color: #fff; border-color: rgb(255 255 255 / 0.6); }
  .v2-under { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .v2-row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }

  /* ---------------------------------------------------------- 1 statement */
  .v2-about { position: relative; background: #121211; color: #f3f1ec; padding: clamp(96px, 11vw, 170px) var(--gutter) clamp(90px, 10vw, 160px); overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; }
  .v2-about__label { justify-self: start; color: rgb(243 241 236 / 0.55); margin-bottom: clamp(18px, 2.4vw, 36px); }
  .v2-about__h {
    justify-self: stretch; display: grid; font-size: 9vw; /* JS fits the widest row to the container */
    font-weight: 500; line-height: 0.86; letter-spacing: -0.055em; text-transform: uppercase; padding-bottom: 0.5em;
  }
  .v2-about__row { display: flex; justify-content: space-between; gap: 0.25em; white-space: nowrap; }
  .v2-about .m { display: inline-block; overflow: hidden; padding: 0.14em 0.04em 0.12em; margin: -0.14em -0.04em -0.12em; }
  .v2-about .m > span { display: inline-block; will-change: transform; }
  .v2-about__br { display: none; }
  .v2-about .m--r { transform: translateY(0.5em); text-align: right; } /* right column drops half a line */
  .v2-about__txt {
    max-width: 30ch; margin-top: clamp(20px, 3vw, 44px); text-align: center; text-wrap: balance;
    font-size: clamp(19px, 14px + 1.1vw, 30px); line-height: 1.22; letter-spacing: -0.03em; color: rgb(243 241 236 / 0.92);
  }
  .v2-about__txt :global(em) { font-style: italic; font-weight: 400; }
  .v2-about__cta { margin-top: 26px; color: #f3f1ec; }
  .v2-about__cta:hover { color: var(--accent); }
  .v2-about__reel { position: relative; width: min(760px, 100%); margin: clamp(48px, 6vw, 90px) 0 0; }
  .v2-about__frame { position: relative; aspect-ratio: 16 / 11; overflow: hidden; border-radius: 14px; background: #222; }
  .v2-about__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.08); transition: opacity 1.1s var(--ease-out), transform 3.2s linear; }
  .v2-about__frame img.is-on { opacity: 1; transform: scale(1); }
  .v2-about__badge { position: absolute; left: 50%; top: 50%; width: clamp(96px, 17vw, 210px); translate: -50% -50%; filter: drop-shadow(0 18px 40px rgb(0 0 0 / 0.45)); }
  .v2-about__badge :global(svg) { display: block; width: 100%; height: auto; }
  :global(html.js) .v2 [data-words] :global(.w) { opacity: 0.18; }

  /* ---------------------------------------------------------- full-bleed banners */
  .v2-bleed { position: relative; height: 100vh; min-height: 560px; overflow: hidden; color: #fff; }
  .v2-bleed > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .v2-bleed::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.08) 55%); }
  .v2-bleed__txt { position: absolute; z-index: 1; left: 50%; bottom: clamp(48px, 8vh, 96px); transform: translateX(-50%); display: grid; justify-items: center; gap: 18px; width: min(900px, 90vw); text-align: center; }
  .v2-bleed__txt p { font-size: clamp(17px, 15px + 0.35vw, 20px); line-height: 1.45; color: rgb(255 255 255 / 0.9); max-width: 42ch; }
  .v2-bleed--quote .v2-bleed__txt { bottom: 50%; transform: translate(-50%, 50%); }
  .v2-bleed--quote::after { background: rgb(0 0 0 / 0.28); }

  /* ---------------------------------------------------------- 3 cards */
  .v2-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .v2-cards a { display: grid; gap: 12px; }
  .v2-cards .v2-label { font-size: clamp(15px, 13px + 0.3vw, 17px); }
  .v2-cards figure { margin: 0 0 6px; aspect-ratio: 4 / 4.4; overflow: hidden; background: #ece8e0; }
  .v2-cards img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .v2-cards a:hover img { transform: scale(1.04); }

  /* ---------------------------------------------------------- 4 feature */
  .v2-feature { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .v2-feature__list { display: grid; gap: 4px; padding-top: 20vh; }
  .v2-feature__list > .v2-label { margin-bottom: 28px; }
  .v2-feature__item { min-height: 34vh; padding: 10px 0 0; border-left: 1px solid #dcd7cc; padding-left: 28px; transition: border-color 0.5s; }
  .v2-feature__item .v2-h { color: #b9b4aa; transition: color 0.5s; }
  .v2-feature__item .v2-small { max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.7s var(--ease-out), opacity 0.6s, margin 0.6s; }
  .v2-feature__item.is-on { border-color: var(--ink9); }
  .v2-feature__item.is-on .v2-h { color: var(--ink9); }
  .v2-feature__item.is-on .v2-small { max-height: 8em; opacity: 1; margin-top: 14px; max-width: 36ch; }
  .v2-feature__media { position: sticky; top: 12vh; display: grid; grid-template-columns: 56px 1fr; gap: 12px; height: 76vh; }
  .v2-feature__thumbs { display: grid; align-content: start; gap: 8px; }
  .v2-feature__thumbs li { aspect-ratio: 1; overflow: hidden; opacity: 0.45; outline: 1px solid transparent; outline-offset: 2px; transition: opacity 0.4s, outline-color 0.4s; }
  .v2-feature__thumbs li.is-on { opacity: 1; outline-color: var(--ink9); }
  .v2-feature__thumbs img { width: 100%; height: 100%; object-fit: cover; }
  .v2-feature__img { position: relative; margin: 0; overflow: hidden; background: #ece8e0; }
  .v2-feature__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.06); transition: opacity 0.8s var(--ease-out), transform 1.4s var(--ease-out); }
  .v2-feature__img img.is-on { opacity: 1; transform: none; }

  /* ---------------------------------------------------------- 6 rows */
  .v2-rows__title { margin-bottom: clamp(40px, 5vw, 72px); padding-left: calc(4% + 3rem + 32px); }
  .v2-rows li { display: grid; grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1fr) 240px; align-items: center; gap: 32px; padding: 28px 0 28px 4%; border-top: 1px solid #dcd7cc; }
  .v2-rows li:last-child { border-bottom: 1px solid #dcd7cc; }
  .v2-rows__n { font-size: 14px; font-weight: 600; color: var(--accent); }
  .v2-rows figure { margin: 0; aspect-ratio: 16 / 10; overflow: hidden; }
  .v2-rows img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.2); transition: filter 0.6s, transform 1s var(--ease-out); }
  .v2-rows li:hover img { filter: none; transform: scale(1.05); }

  /* ---------------------------------------------------------- 7 quote */
  .v2-quote { display: grid; grid-template-columns: 1fr 1fr; min-height: 100vh; }
  .v2-quote__img { margin: 0; overflow: hidden; }
  .v2-quote__img img { width: 100%; height: 100%; object-fit: cover; }
  .v2-quote__txt { display: grid; align-content: center; justify-items: center; gap: 28px; padding: 48px clamp(24px, 6vw, 110px); text-align: center; }
  .v2-quote__stack { display: grid; }
  .v2-quote__stack blockquote { grid-area: 1 / 1; margin: 0; display: grid; gap: 22px; justify-items: center; opacity: 0; transform: translateY(12px); transition: opacity 0.8s var(--ease-out), transform 0.9s var(--ease-out); pointer-events: none; }
  .v2-quote__stack blockquote.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .v2-quote__stack .v2-h { max-width: 15ch; }
  .v2-quote__stack cite { font-style: normal; max-width: 38ch; }
  .v2-quote__dots { display: flex; gap: 8px; }
  .v2-quote__dots button { position: relative; width: 44px; height: 2px; background: #dcd7cc; overflow: hidden; }
  .v2-quote__dots button i { position: absolute; inset: 0; background: var(--ink9); transform: scaleX(0); transform-origin: left; }
  .v2-quote__dots button.is-on i { animation: v2-fill 5s linear forwards; }
  @keyframes v2-fill { to { transform: scaleX(1); } }

  /* ---------------------------------------------------------- 8 prices */
  .v2-prices__list { max-width: 1100px; margin: 0 auto; }
  .v2-prices__list li { display: grid; grid-template-columns: 1fr 1.2fr auto; align-items: baseline; gap: 32px; padding: 26px 0; border-top: 1px solid #dcd7cc; }
  .v2-prices__list li:last-child { border-bottom: 1px solid #dcd7cc; }
  .v2-prices__list .v2-label { color: #8b877e; }
  .v2-form { max-width: 1100px; margin: clamp(40px, 5vw, 64px) auto 0; display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 10px; }
  .v2-form input, .v2-form select { padding: 17px 18px; font: inherit; font-size: 16px; background: #fff; border: 1px solid #dcd7cc; border-radius: 10px; color: var(--ink9); }
  .v2-form input:focus, .v2-form select:focus { outline: none; border-color: var(--ink9); }

  :global(html.js) .v2 [data-up] { opacity: 0; }

  @media (max-width: 700px) {
    .v2-about__h { padding-bottom: 0; }
    .v2-about__row--full { flex-wrap: wrap; justify-content: flex-start; gap: 0 0.25em; }
    .v2-about__br.is-on { display: block; flex-basis: 100%; height: 0; }
    .v2-about__row--pair { flex-direction: column; gap: 0; }
    .v2-about .m--r { transform: none; align-self: flex-end; }
    .v2-about__reel { margin-top: 44px; }
  }
  @media (max-width: 900px) {
    .v2-cards { grid-template-columns: 1fr; }
    .v2-feature { grid-template-columns: 1fr; }
    .v2-feature__list { padding-top: 0; }
    .v2-feature__item { min-height: 0; padding-bottom: 18px; }
    .v2-feature__item .v2-small { max-height: none; opacity: 1; margin-top: 8px; }
    .v2-feature__media { position: relative; top: 0; height: 60vh; grid-template-columns: 1fr; }
    .v2-feature__thumbs { display: none; }
    .v2-rows__title { padding-left: 0; }
    .v2-rows li { grid-template-columns: 2rem 1fr; gap: 14px 16px; padding-left: 0; }
    .v2-rows li .v2-small, .v2-rows li figure { grid-column: 2; }
    .v2-quote { grid-template-columns: 1fr; }
    .v2-quote__img { aspect-ratio: 4 / 3; }
    .v2-prices__list li { grid-template-columns: 1fr auto; gap: 6px 16px; padding: 20px 0; }
    .v2-prices__list li .v2-small { grid-column: 1; grid-row: 2; }
    .v2-form { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { scrollToSection } from '@/scripts/navigation';
  gsap.registerPlugin(ScrollTrigger);
  const $ = (s: string) => Array.from(document.querySelectorAll<HTMLElement>(s));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // about: size the giant headline so its widest row (full row, or left + right of neighbouring pairs) fills the width
  const about = document.querySelector<HTMLElement>('[data-about]');
  const narrow = window.matchMedia('(max-width: 700px)');
  const fitH = () => {
    const h = about?.querySelector<HTMLElement>('[data-fit]');
    if (!h) return;
    h.style.fontSize = '100px';
    const w = (el: Element | null | undefined) => (el ? (el.firstElementChild as HTMLElement).getBoundingClientRect().width : 0);
    const gap = 25; // 0.25em at 100px
    const full = h.querySelector('.v2-about__row--full')!;
    const fw = Array.from(full.querySelectorAll('.m')).reduce((t, m, i) => t + w(m) + (i ? gap : 0), 0);
    const pairs = Array.from(h.querySelectorAll('.v2-about__row--pair')).map((r) => [w(r.querySelector('.m:not(.m--r)')), w(r.querySelector('.m--r'))]);
    let need = fw;
    if (narrow.matches) {
      // phones: the full row breaks in two (best split), pairs stack — every phrase gets its own line
      const ws = Array.from(full.querySelectorAll('.m')).map(w);
      need = Infinity;
      let split = 1;
      for (let k = 1; k < ws.length; k++) {
        const line = (a: number[]) => a.reduce((t, x, i) => t + x + (i ? gap : 0), 0);
        const n = Math.max(line(ws.slice(0, k)), line(ws.slice(k)));
        if (n < need) { need = n; split = k; }
      }
      full.querySelectorAll('.v2-about__br').forEach((b, i) => b.classList.toggle('is-on', i === split - 1));
      pairs.forEach(([l, r]) => { need = Math.max(need, l, r); });
    } else {
      full.querySelectorAll('.v2-about__br').forEach((b) => b.classList.remove('is-on'));
      pairs.forEach(([l, r], i) => { need = Math.max(need, l + r + 2 * gap, i + 1 < pairs.length ? pairs[i + 1][0] + r + 2 * gap : 0); });
    }
    h.style.fontSize = `${Math.min(240, (98.5 * h.clientWidth) / need)}px`; // 1.5% safety for rounding
  };
  fitH();
  document.fonts?.ready.then(() => { fitH(); ScrollTrigger.refresh(); });
  let fitT = 0;
  addEventListener('resize', () => { clearTimeout(fitT); fitT = window.setTimeout(fitH, 120); });
  narrow.addEventListener('change', fitH);

  // about reel: crossfade the frames while it is on screen
  const reelImgs = $('[data-reel] img');
  let ri = 0, reelTimer = 0;
  const reelStep = () => { reelImgs[ri].classList.remove('is-on'); ri = (ri + 1) % reelImgs.length; reelImgs[ri].classList.add('is-on'); };
  if (reelImgs.length > 1 && !reduced) ScrollTrigger.create({ trigger: '[data-reel]', start: 'top bottom', end: 'bottom top', onToggle: (st) => { clearInterval(reelTimer); if (st.isActive) reelTimer = window.setInterval(reelStep, 2600); } });

  if (reduced) {
    gsap.set($('.v2 [data-up]'), { opacity: 1 });
    $('.v2 [data-words] .w').forEach((w) => (w.style.opacity = '1'));
  } else {
    // statement: words light up as it scrolls through
    $('.v2 [data-words]').forEach((p) => gsap.to(p.querySelectorAll('.w'), { opacity: 1, stagger: 0.1, ease: 'none', scrollTrigger: { trigger: p, start: 'top 75%', end: 'bottom 40%', scrub: 0.6 } }));
    // about: headline rows rise out of their masks, the reel opens from a smaller frame, the badge settles
    if (about) {
      gsap.set(about.querySelectorAll('.m > span'), { yPercent: 110 });
      ScrollTrigger.create({ trigger: about.querySelector('[data-fit]'), start: 'top 82%', once: true, onEnter: () => {
        gsap.to(about.querySelectorAll('.v2-about__row--full .m > span'), { yPercent: 0, duration: 1.25, ease: 'expo.out', stagger: 0.06 });
        gsap.to(about.querySelectorAll('.v2-about__row--pair .m > span'), { yPercent: 0, duration: 1.25, ease: 'expo.out', stagger: 0.09, delay: 0.25 });
      } });
      const reel = about.querySelector('[data-reel]');
      gsap.fromTo(reel!.querySelector('.v2-about__frame'), { clipPath: 'inset(14% 20% 14% 20% round 14px)' }, { clipPath: 'inset(0% 0% 0% 0% round 14px)', ease: 'none', scrollTrigger: { trigger: reel, start: 'top 95%', end: 'center 55%', scrub: 0.8 } });
      gsap.fromTo(reel!.querySelector('.v2-about__badge'), { scale: 0.55, rotate: -14, yPercent: 30 }, { scale: 1, rotate: 0, yPercent: 0, ease: 'none', scrollTrigger: { trigger: reel, start: 'top 95%', end: 'center 50%', scrub: 0.8 } });
    }
    // quiet rise for headers, cards and rows
    ScrollTrigger.batch($('.v2 [data-up]'), { start: 'top 90%', once: true, onEnter: (b) => gsap.fromTo(b, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out', stagger: 0.09 }) });
    // full-bleed photos: slow zoom-out with the scroll, caption rises
    $('.v2 [data-bleed]').forEach((sec) => {
      const img = sec.querySelector('[data-zoom]');
      gsap.fromTo(img, { scale: 1.18 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true } });
      gsap.fromTo(sec.querySelector('.v2-bleed__txt'), { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', scrollTrigger: { trigger: sec, start: 'top 45%', once: true } });
    });
    const qImg = document.querySelector('.v2-quote__img img');
    if (qImg) gsap.fromTo(qImg, { scale: 1.15 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '.v2-quote', start: 'top bottom', end: 'bottom top', scrub: true } });
  }

  // studio feature: the item in the middle of the screen drives the sticky image
  const items = $('[data-feat]');
  const imgs = $('[data-feat-img]');
  const thumbs = $('.v2-feature__thumbs [data-thumb]');
  const setFeat = (n: number) => [items, imgs, thumbs].forEach((g) => g.forEach((el, i) => el.classList.toggle('is-on', i === n)));
  items.forEach((it, i) => ScrollTrigger.create({ trigger: it, start: 'top 55%', end: 'bottom 55%', onToggle: (s) => { if (s.isActive) setFeat(i); } }));
  thumbs.forEach((t, i) => t.addEventListener('click', () => setFeat(i)));

  // booking form: validates locally; nothing is sent until a backend exists
  const form = document.querySelector<HTMLFormElement>('[data-booking]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const req = Array.from(form.querySelectorAll<HTMLInputElement>('[required]'));
    let ok = true;
    req.forEach((f) => { const bad = !f.value.trim(); f.setAttribute('aria-invalid', String(bad)); if (bad) ok = false; });
    const err = form.querySelector<HTMLElement>('[data-err]')!, done = form.querySelector<HTMLElement>('[data-done]')!;
    err.hidden = ok; done.hidden = !ok;
    if (!ok) { req.find((f) => !f.value.trim())?.focus(); return; }
    form.querySelector<HTMLButtonElement>('button[type=submit]')!.disabled = true;
  });

  // in-page links glide like the header's
  $('.v2 a[data-scroll-to]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); scrollToSection((a as HTMLAnchorElement).dataset.scrollTo!); }));

  // rotating quote
  const qs = $('[data-q]');
  const dots = $('[data-dot]');
  let qi = 0;
  const showQ = (n: number) => { qi = (n + qs.length) % qs.length; qs.forEach((q, i) => q.classList.toggle('is-on', i === qi)); dots.forEach((d, i) => { d.classList.remove('is-on'); void d.offsetWidth; d.classList.toggle('is-on', i === qi); }); };
  dots.forEach((d, i) => { d.addEventListener('click', () => showQ(i)); d.querySelector('i')!.addEventListener('animationend', () => { if (i === qi && !reduced) showQ(qi + 1); }); });
</script>
