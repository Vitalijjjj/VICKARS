const d = D[slug];
---

<BaseLayout locale="uk" path={`/levels/${slug}/`} title={`${d.title} — VIK Cars, Лімасол`} footer={false} preload={d.image}>
  <div class="dl" data-pt style="background:#1d1815">
    <Ambience />
    <DirHero code={d.code} title={d.title} lead={d.lead} image={d.image} video={d.video} facts={d.facts} />
    {d.intro === 'self' && <SelfWashScrub ctaLabel="Обрати пакет" ctaHref="#pricing" />}
    {d.story && <Story />}
    {d.cases && <Cases cases={d.cases} isNew={false} />}
    {d.journey ? <Journey /> : <DirProcess steps={d.steps} isNew={false} />}
    {d.protect && <Protect />}
    {d.quiz && <Quiz />}
    <Tariffs only={d.tariffs} isNew={false} />
    <Benefits items={d.benefits} isNew={false} />
    <Reviews isNew={false} />
    {d.journal && <Journal />}
    <ContactsMap isNew={false} />
    <GlassFooter image={d.footer} />
  </div>
</BaseLayout>

<script>
  import { initProto } from '@/scripts/proto';
  initProto();
</script>
