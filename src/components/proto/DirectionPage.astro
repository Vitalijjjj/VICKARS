    ],
    tariffs: 'lounge', footer: `${m}level-lounge-showroom-v2-s2.webp`, story: true,
    benefits: [
      ['Не на вулиці', 'Жодних табуреток біля мийки — чекаєте з видом на пагорби.', 'cup'], ['Робоча зона', 'Тиша, Wi-Fi і зарядки, щоб час не пропадав.', 'wifi'],
      ['Переговорна', 'Можна провести зустріч, поки миють авто.', 'room'], ['Консультації', 'Підбір плівки й кераміки прямо в шоурумі.', 'chat'],
      ['Презентації', 'Приватні покази авто й вечори для клієнтів.', 'star'], ['Звіт онлайн', 'Фото процесу — у вашому телефоні.', 'phone'],
