---
/**
 * Direction page in the new design (UA): 00 Ручна мийка, −01 Детейлінг-студія, +01 Лаунж і шоурум, Самомийка.
 * Structure from the client sitemap: nav · first screen (video/still) · cases · process · CTA + packages ·
 * what you get · Google reviews · CTA + contacts + map · footer.
 * Copy is a DRAFT for the client; cases/reviews/prices are placeholders until real material arrives.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/proto.css';
import DirHero from './blocks/DirHero.astro';
import Cases from './blocks/Cases.astro';
import DirProcess from './blocks/DirProcess.astro';
import Tariffs from './blocks/Tariffs.astro';
import Benefits from './blocks/Benefits.astro';
import Reviews from './blocks/Reviews.astro';
import ContactsMap from './blocks/ContactsMap.astro';
import GlassFooter from './blocks/GlassFooter.astro';
import SelfWashScrub from './blocks/SelfWashScrub.astro';
import Ambience from './blocks/Ambience.astro';
import Journey from './blocks/Journey.astro';
import Story from './blocks/Story.astro';
import Protect from './blocks/Protect.astro';
import Quiz from './blocks/Quiz.astro';
import Journal from './blocks/Journal.astro';

export type DirSlug = 'car-wash' | 'detailing-studio' | 'lounge-showroom' | 'self-wash';
interface Props { slug: DirSlug }
const { slug } = Astro.props;
const m = '/media/';
const sm = (n: string) => `${m}${n}-sm.webp`;

type Case = { name: string; service: string; time: string; image: string; note: string };
interface Dir {
  code: string; title: string; lead: string; image: string; video?: string; facts: [string, string][];
  cases?: Case[]; steps: [string, string, string][]; tariffs: 'wash' | 'studio' | 'self' | 'lounge';
  benefits: [string, string, string][]; footer: string; intro?: 'self';
  /** blocks moved off the home page that live on this direction */
  journey?: boolean; story?: boolean; protect?: boolean; quiz?: boolean; journal?: boolean;
}
const D: Record<DirSlug, Dir> = {
  'car-wash': {
    code: '00', title: 'Ручна мийка', image: `${m}level-car-wash-v2.webp`, video: `${m}journey-wash-v1.mp4`,
    lead: 'Шість постів ручної мийки преміум-класу. Піна, мікрофібра й жодних автоматичних щіток — від огляду до видачі.',
