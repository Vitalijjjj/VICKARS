    cases: [
      { name: 'Porsche 911 · кераміка', service: 'Мийка + кераміка', time: '1 день', image: `${m}level-detailing-studio-v2.webp`, note: 'Двофазна мийка, деконтамінація, полірування в один крок і кераміка 1 шар.' },
      { name: 'Range Rover · Signature', service: 'Ручна мийка Signature', time: '3 год', image: `${m}level-car-wash-v2-s1.webp`, note: 'Очищення бітуму й металу, глибока чистка салону, захисний сілант.' },
