      ['Заїжджаєте на пост', 'Вільний пост видно з дороги — без запису й черги.', sm('level-car-wash-v2-s3')],
      ['Оплачуєте', 'Карткою або телефоном прямо на терміналі посту.', sm('level-car-wash-v2')],
      ['Обираєте програму', 'Піна, вода, віск чи осмос — перемикаєте будь-коли.', sm('level-car-wash-v2-s1')],
      ['Миєте', 'Таймер рахує лише поки працює програма.', sm('level-car-wash-v2-s2')],
      ['Фініш', 'Осмос без розводів — і можна їхати.', sm('level-detailing-studio-v2-s1')],
    ],
    tariffs: 'self', footer: `${m}level-car-wash-v2-s3.webp`,
    benefits: [
      ['Без запису', 'Приїжджаєте, коли зручно.', 'clock'], ['Проф. хімія', 'Ті самі засоби, що й на ручній мийці.', 'sparkle'],
      ['Чесні хвилини', 'Платите лише за роботу програми.', 'tag'], ['Осмос', 'Фінальне ополіскування без розводів.', 'drop'],
      ['Картка', 'Оплата на посту — без жетонів.', 'card'], ['Поруч допомога', 'Майстер ручної мийки підкаже, якщо потрібно.', 'user'],
    ],
  },
