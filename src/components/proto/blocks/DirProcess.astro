---
/** NEW · Процес роботи (direction page). Dark. Pinned horizontal track of step cards that slides with the scroll,
 *  a thin progress line under it. Phones: vertical list. */
interface Props { steps: [string, string, string][]; isNew?: boolean }
const { steps, isNew = true } = Astro.props;
---

<section class="dp" data-bg="#1d1815" data-theme="dark" data-dp>
  {isNew && <span class="pt-new">Новий блок · Процес роботи</span>}
  <div class="dp__stage">
    <header class="dp__head">
      <h2 class="dl-display dl-display--m" data-lines><span class="ln"><span><small>Процес</small> роботи</span></span></h2>
    </header>
    <div class="dp__track" data-dp-track>
      {steps.map(([t, d, img], i) => (
        <article class="dp__card">
          <figure><img src={img} alt="" loading="lazy" /></figure>
          <span class="dl-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{t}</h3>
          <p>{d}</p>
        </article>
      ))}
    </div>
    <div class="dp__bar" aria-hidden="true"><i data-dp-bar></i></div>
  </div>
</section>

<style>
  .dp__stage { position: relative; min-height: 100vh; min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; gap: 40px; padding: calc(var(--header-h) + 56px) 0 48px; overflow: hidden; }
  .dp__head { padding: 0 var(--gutter); }
  .dp__track { display: flex; gap: 20px; padding: 0 var(--gutter); width: max-content; align-self: center; will-change: transform; }
  .dp__card { width: clamp(280px, 28vw, 400px); display: grid; gap: 12px; }
  .dp__card figure { margin: 0 0 8px; aspect-ratio: 4 / 3; border-radius: 16px; overflow: hidden; }
  .dp__card img { width: 100%; height: 100%; object-fit: cover; }
  .dp__card .dl-num { font-size: 34px; line-height: 1; }
  .dp__card h3 { margin: 0; font-size: 22px; font-weight: 500; letter-spacing: -0.03em; }
  .dp__card p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--cream-2); max-width: 34ch; }
  .dp__bar { margin: 0 var(--gutter); height: 1px; background: rgb(244 230 216 / 0.18); }
  .dp__bar i { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  @media (max-width: 900px) {
    .dp__track { flex-direction: column; width: auto; }
    .dp__card { width: auto; }
    .dp__bar { display: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll<HTMLElement>('[data-dp]').forEach((dp) => {
    const track = dp.querySelector<HTMLElement>('[data-dp-track]')!, bar = dp.querySelector<HTMLElement>('[data-dp-bar]')!;
    const mm = gsap.matchMedia();
    mm.add('(min-width: 901px) and (prefers-reduced-motion: no-preference)', () => {
      const dist = () => Math.max(0, track.scrollWidth - window.innerWidth);
      gsap.to(track, { x: () => -dist(), ease: 'none', scrollTrigger: { trigger: dp, start: 'top top', end: () => `+=${dist() + window.innerHeight * 0.3}`, pin: dp.querySelector('.dp__stage'), scrub: 0.6, invalidateOnRefresh: true, onUpdate: (st) => gsap.set(bar, { scaleX: st.progress }) } });
    });
  });
</script>
