---
/** CTA + Контакти + Де ми на карті. Dark. A full-width game-style navigation map (GtaMap)
 *  with a glass contact card + call-back form over it. `tall` = the bigger variant for the contacts page. */
import { business } from '@/config/business';
import GtaMap from './GtaMap.astro';
interface Props { isNew?: boolean; tall?: boolean; title?: boolean }
const { isNew = true, tall = false, title = true } = Astro.props;
const tel = business.phone ? `tel:${business.phone.replace(/\s/g, '')}` : '#';
const arrow = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 14L14 6M7 6h7v7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
---

<section class:list={['cm', { 'cm--tall': tall }]} data-bg="#1d1815" data-theme="dark" id="contacts">
  {isNew && <span class="pt-new">Новий блок · CTA + контакти + карта</span>}
  {title && (
    <div class="cm__title dl-sec">
      <p class="dl-eyebrow" data-up style="text-align:center">Лімасол · Кіпр</p>
      <h2 class="dl-display dl-display--m" data-lines><span class="ln"><span><small>Де</small> ми на карті</span></span></h2>
    </div>
  )}
  <div class="cm__map">
    <div class="cm__canvas"><GtaMap /></div>
    <aside class="cm__card dl-glass-card" data-up>
      <span class="cm__pin" aria-hidden="true"></span>
      <h3>VIK Cars</h3>
      <dl>
        <dt>Адреса</dt><dd>Лімасол, Кіпр <span class="pt-draft">точна адреса уточнюється</span></dd>
        <dt>Телефон</dt><dd><a href={tel}>{business.phone}</a></dd>
        <dt>Графік</dt><dd>Щодня {business.hours} <span class="pt-draft">попередньо</span></dd>
      </dl>
      <!-- messengers: real links once the client sends the handles -->
      <div class="cm__msg">
        <a href="#" aria-label="WhatsApp" title="WhatsApp" style="--b:#25d366" set:html={`<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.2 21.8l4.9-1.3A9.8 9.8 0 1 0 12 2.2zm0 17.8a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.2-.2-.2-.5-.4z"/></svg>`} />
        <a href="#" aria-label="Telegram" title="Telegram" style="--b:#29a9eb" set:html={`<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.4 3.6 2.9 10.7c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.8.8s.6-.2.9-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.7c.3-1.3-.5-1.9-1.4-1.6zM9.6 13.4l8.6-5.4c.4-.3.8-.1.5.2l-7.1 6.4-.3 3.3-1.7-4.5z"/></svg>`} />
        <a href="#" aria-label="Viber" title="Viber" style="--b:#7360f2" set:html={`<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11.6 2c-2.2 0-6.5.3-8.4 2.1C1.8 5.5 1.3 7.6 1.2 10.2c0 2.6-.1 7.4 4.5 8.7v2c0 .5.4.8.8.5l2.4-2.6c4.3.4 7.5-.4 7.9-.6 3.4-1.1 4.6-4.7 4.8-8.1.2-3.8-.7-6.4-2.1-7.5C18.5 2.2 14.6 2 11.6 2zm.5 2.4c.2 0 .3.1.3.3s-.1.3-.3.3a5.5 5.5 0 0 1 5.4 5.6c0 .2-.1.3-.3.3s-.3-.1-.3-.3a4.9 4.9 0 0 0-4.8-5zm-4.3 1c.3 0 .5.1.7.4l1 1.4c.2.4.2.8-.1 1.1l-.5.4c-.2.2-.3.4-.2.7a6.6 6.6 0 0 0 3.6 3.6c.3.1.5 0 .7-.2l.4-.5c.3-.4.7-.4 1.1-.1l1.4 1c.4.3.4.8.1 1.2-.5.7-1.2 1.2-2 1-3.5-1-6.6-4.1-7.5-7.6-.2-.8.3-1.5 1-2 .1-.2.2-.3.3-.4zm4.6.6a3.7 3.7 0 0 1 3.6 3.7c0 .2-.1.3-.3.3s-.3-.1-.3-.3a3.1 3.1 0 0 0-3-3.1c-.2 0-.3-.1-.3-.3s.1-.3.3-.3zm.1 1.6c1 0 1.9.9 1.9 2 0 .2-.1.3-.3.3s-.3-.1-.3-.3c0-.8-.6-1.4-1.3-1.4-.2 0-.3-.1-.3-.3s.1-.3.3-.3z"/></svg>`} />
      </div>
      <div class="cm__btns">
        <a class="dl-pill dl-pill--accent" href={tel}>Подзвонити</a>
        <a class="dl-pill dl-pill--ghost" href={business.mapsUrl ?? '#'} target="_blank" rel="noopener">Маршрут <span set:html={arrow} class="cm__ico" /></a>
      </div>
      <form class="cm__form" data-cm-form novalidate>
        <input class="dl-field" type="tel" name="phone" placeholder="Ваш номер — передзвонимо" aria-label="Телефон" />
        <button class="dl-round dl-round--accent" type="submit" aria-label="Надіслати"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </form>
    </aside>
  </div>
</section>

<style>
  .cm { position: relative; }
  .cm__title { padding-bottom: clamp(40px, 5vw, 64px); }
  .cm__map { position: relative; height: 86vh; min-height: 620px; margin: 0 var(--gutter); border-radius: 26px; overflow: hidden; }
  .cm--tall .cm__map { height: 92vh; }
  .cm__canvas { position: absolute; inset: 0; }
  .cm__card { position: absolute; z-index: 1000; left: 28px; top: 28px; bottom: 28px; width: min(420px, calc(100% - 56px)); display: grid; align-content: start; gap: 22px; padding: 30px; color: #fff; background: rgb(29 24 21 / 0.82); border-radius: 22px; box-shadow: inset 0 0 0 1px rgb(244 230 216 / 0.1), 0 20px 50px rgb(0 0 0 / 0.45); backdrop-filter: blur(16px); }
  .cm__pin { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 6px rgb(229 37 50 / 0.25), 0 0 0 14px rgb(229 37 50 / 0.1); animation: cm-ping 2.4s ease-out infinite; }
  @keyframes cm-ping { 50% { box-shadow: 0 0 0 10px rgb(229 37 50 / 0.15), 0 0 0 22px rgb(229 37 50 / 0.04); } }
  .cm__card h3 { margin: 0; font-size: 34px; font-weight: 500; letter-spacing: -0.04em; }
  .cm__card dl { margin: 0; display: grid; grid-template-columns: 92px 1fr; gap: 12px 14px; font-size: 16px; }
  .cm__card dt { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cream-2); padding-top: 3px; }
  .cm__card dd { margin: 0; display: grid; }
  .cm__msg { display: flex; gap: 10px; }
  .cm__msg a { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; color: #fff; background: rgb(255 255 255 / 0.06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2); transition: background 0.3s, box-shadow 0.3s, transform 0.3s; }
  .cm__msg a:hover { background: var(--b); box-shadow: 0 8px 22px color-mix(in srgb, var(--b) 45%, transparent); transform: translateY(-2px); }
  .cm__msg :global(svg) { width: 22px; height: 22px; }
  .cm__btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .cm__ico { display: inline-grid; width: 16px; margin-left: 6px; }
  .cm__ico :global(svg) { width: 16px; height: 16px; }
  .cm__form { display: flex; gap: 8px; margin-top: auto; }
  .cm__form .dl-field { flex: 1; min-width: 0; }
  @media (max-width: 900px) {
    .cm__map { height: auto; min-height: 0; display: grid; margin: 0 12px; }
    .cm__canvas { position: relative; height: 62vh; }
    .cm__card { position: relative; left: auto; top: auto; bottom: auto; width: auto; border-radius: 0 0 26px 26px; background: rgb(24 20 18 / 0.92); }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-cm-form]').forEach((f) => f.addEventListener('submit', (e) => {
    e.preventDefault();
    const i = f.querySelector('input')!;
    if (!i.value.trim()) { i.focus(); return; }
    i.value = ''; i.placeholder = 'Дякуємо! Передзвонимо.';   // prototype: nothing is sent
  }));
</script>
