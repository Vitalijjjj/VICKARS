---
/** «Що ви отримаєте». Full-bleed photo (the lounge panorama). Left: the title with the lead and
 *  the «Залишити заявку» button under it (opens the booking pop-up); right: a deck of big glass cards. The section pins and the cards
 *  ride up one by one and stack on each other (the ones below shrink and dim); after the last one the page moves on.
 *  `items` can be overridden per direction page; the third element of an item picks its icon. */
interface Props { isNew?: boolean; items?: ([string, string] | [string, string, string])[]; image?: string; lead?: string }
const {
  isNew = true,
  image = '/media/benefits-pedestal-a.webp',   // Higgsfield: the lounge with a lit concrete plinth (materials/working/benefits-pedestal/ped-a.png)
  lead = 'Стандарт VIK — однаковий для кожного авто, незалежно від послуги й чека.',
  items = [
    ['Фотоогляд при прийомі', 'Фіксуємо стан авто до роботи — фото надсилаємо вам у месенджер.', 'cam'],
    ['Лаунж замість табуретки', 'Кава, Wi-Fi і тиша на другому поверсі, поки працюємо з авто.', 'cup'],
    ['Відповідальний майстер', 'Одна людина веде ваше авто від прийому до видачі й підписує чек-лист.', 'user'],
    ['Без черги', 'Шість постів і запис на час — приїжджаєте у своє вікно.', 'clock'],
    ['Чесна ціна після огляду', 'Називаємо вартість до старту робіт і не змінюємо її по ходу.', 'tag'],
    ['Гарантія на захист', 'PPF і кераміка — з гарантійним талоном і графіком догляду.', 'shield'],
  ],
} = Astro.props;
import { srcset } from '@/lib/img';
const fallback = ['cam', 'cup', 'user', 'clock', 'tag', 'shield'];
const ic: Record<string, string> = {
  cam: '<rect x="3" y="7" width="18" height="13" rx="3"/><circle cx="12" cy="13.5" r="3.5"/><path d="M8.5 7l1.5-3h4l1.5 3"/>',
  cup: '<path d="M4 9h13v4a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17M8 3c-1 1.5 1 2.5 0 4M12 3c-1 1.5 1 2.5 0 4"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/><path d="M15.5 13.5l1.5 1.5 3-3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  tag: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  drop: '<path d="M12 3.5s6 6.6 6 11a6 6 0 0 1-12 0c0-4.4 6-11 6-11z"/><path d="M9.2 15.2a3 3 0 0 0 2.8 2.8"/>',
  sparkle: '<path d="M12 3l1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7z"/><path d="M18.5 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>',
  light: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.9V16h5v-.2c0-.8.4-1.5 1-1.9A6 6 0 0 0 12 3z"/>',
  phone: '<rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M10.5 18.5h3"/>',
  lift: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M12 3v18M8 9l-1.5 2h3zM16 13l-1.5-2h3z"/>',
  wifi: '<path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19" r="1"/>',
  room: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9.5h8M8 12.5h5"/>',
  star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 16.9 6.7 19.6l1-5.8L3.5 9.7l5.9-.9z"/>',
  card: '<rect x="3" y="6" width="18" height="12" rx="2.5"/><path d="M3 10h18M7 14.5h4"/>',
  check: '<rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M9 3.5h6v3H9zM8.5 12l2.5 2.5 4.5-5"/>',
};
---

<section class="bn" id="benefits" data-bg="#1d1815" data-theme="dark" data-bn>
  {isNew && <span class="pt-new">Новий блок · Що ви отримаєте</span>}
  <div class="bn__stage" data-bn-stage>
    <!-- the photo opens from a rounded card to full-bleed on the way in and folds back on the way out -->
    <div class="bn__media" data-bn-media><img class="bn__bg" src={image} srcset={srcset(image)} sizes="142vw" alt="" loading="lazy" decoding="async" /></div>
    <div class="bn__in">
      <header class="bn__head">
        <h2 class="bn__title" data-lines><span class="ln"><span class="bn__t1">Що ви</span></span><span class="ln"><span class="bn__t2">отримаєте</span></span></h2>
        <p class="bn__lead" data-up>{lead}</p>
        <div class="bn__cta" data-up>
          <a class="dl-pill dl-pill--accent" href="#booking">Залишити заявку</a>
          <a class="dl-round dl-round--accent" href="#booking" aria-label="Залишити заявку"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </header>
      <div class="bn__side">
        <ol class="bn__deck" data-bn-deck>
          {items.map(([t, d, k], i) => (
            <li class="bn__card" style={`--i:${i}`} data-bn-card>
              <div class="bn__top">
                <span class="bn__ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ic[k ?? fallback[i % 6]] ?? ic.check} /></span>
                <em>{String(i + 1).padStart(2, '0')}</em>
              </div>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .bn { position: relative; color: #fff; }
  .bn__stage { position: relative; height: 100vh; height: 100svh; min-height: 640px; overflow: hidden; display: grid; align-items: center; }
  .bn__media { position: absolute; inset: 0; overflow: hidden; clip-path: inset(0 round 0); will-change: clip-path; }
  /* the photo is scaled up and shifted so the plinth (centre of the frame) lands right under the card deck */
  .bn__bg { position: absolute; left: 0; top: 50%; width: 142%; height: 142%; max-width: none; translate: 0 -47%; object-fit: cover; object-position: 50% 62%; }
  .bn__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, #1d1815 0%, rgb(17 14 12 / 0.5) 16%, rgb(17 14 12 / 0.32) 45%, rgb(17 14 12 / 0.5) 82%, #1d1815 100%), linear-gradient(90deg, rgb(17 14 12 / 0.55), transparent 55%); }
  .bn__in { position: relative; z-index: 2; max-width: 1240px; width: 100%; margin: 0 auto; padding: calc(var(--header-h) + 30px) var(--gutter) 40px; display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .bn__head { display: grid; gap: 20px; align-content: center; justify-items: start; }
  /* title: big caps, and the italic word tucked right under it with an indent — one compact lockup */
  .bn__title { margin: 0; display: grid; color: #fff; line-height: 0.86; }
  .bn__title .ln { display: block; overflow: hidden; padding: 0.04em 0 0.06em; }
  .bn__title .ln > span { display: inline-block; }
  .bn__t1 { font-size: clamp(3.4rem, 1.4rem + 5.4vw, 7.6rem); font-weight: 600; letter-spacing: -0.06em; text-transform: uppercase; }
  .bn__t2 { margin: -0.08em 0 0 0.9em; font-size: clamp(2.4rem, 1rem + 3.8vw, 5.4rem); font-weight: 200; font-style: italic; letter-spacing: -0.045em; color: var(--cream); }
  .bn__lead { margin: 0; max-width: 30ch; font-size: 18px; line-height: 1.5; color: rgb(255 255 255 / 0.82); text-wrap: balance; }
  .bn__side { display: grid; }
  .bn__cta { display: inline-flex; gap: 6px; margin-top: 8px; }

  /* the deck: every card sits in the same spot; the scroll brings them up one after another */
  .bn__deck { position: relative; height: 360px; margin: 0; padding: 0; list-style: none; perspective: 1400px; }
  /* the stack rests on the plinth: a warm light pool + contact shadow under the cards */
  .bn__deck::before { content: ''; position: absolute; left: 4%; right: 4%; bottom: -6px; height: 60px; border-radius: 50%; background: radial-gradient(closest-side, rgb(255 214 160 / 0.35), transparent); filter: blur(10px); }
  .bn__deck::after { content: ''; position: absolute; left: 8%; right: 8%; bottom: 26px; height: 22px; border-radius: 50%; background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), transparent); filter: blur(6px); }
  .bn__card {
    position: absolute; left: 0; right: 0; top: calc(var(--i) * 0px); display: grid; align-content: start; gap: 14px; height: 320px; padding: 30px 32px; border-radius: 28px; transform-origin: 50% 0;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.26), rgb(255 255 255 / 0.08) 50%, rgb(255 255 255 / 0.15)), rgb(28 24 21 / 0.42);
    -webkit-backdrop-filter: blur(26px) saturate(1.6); backdrop-filter: blur(26px) saturate(1.6);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.55), inset 0 0 0 1px rgb(255 255 255 / 0.2), 0 30px 70px rgb(0 0 0 / 0.35);
  }
  .bn__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .bn__ico { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 18px; background: rgb(255 255 255 / 0.14); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.4); }
  .bn__ico svg { width: 30px; height: 30px; }
  .bn__top em { font-style: italic; font-weight: 200; font-size: 56px; line-height: 1; opacity: 0.8; }
  .bn__card h3 { margin: 0; font-size: clamp(26px, 20px + 0.9vw, 34px); font-weight: 500; letter-spacing: -0.035em; }
  .bn__card p { margin: 0; max-width: 40ch; font-size: 17px; line-height: 1.5; color: rgb(255 255 255 / 0.85); }

  @media (max-width: 900px) {
    .bn__stage { min-height: 0; }
    .bn__in { grid-template-columns: 1fr; gap: 18px; padding-top: calc(var(--header-h) + 16px); padding-bottom: 16px; align-content: start; }
    .bn__head { gap: 10px; }
    .bn__lead { font-size: 15px; }
    .bn__deck { height: 300px; }
    .bn__card { height: 270px; padding: 22px; border-radius: 22px; }
    .bn__top { margin-bottom: 8px; }
    .bn__ico { width: 48px; height: 48px; }
    .bn__top em { font-size: 42px; }
    .bn__card p { font-size: 15px; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-bn]').forEach((sec) => {
    const stage = sec.querySelector<HTMLElement>('[data-bn-stage]')!, media = sec.querySelector<HTMLElement>('[data-bn-media]')!;
    const cards = Array.from(sec.querySelectorAll<HTMLElement>('[data-bn-card]'));
    const N = cards.length, STEP = 14;   // px each stacked card peeks above the next
    if (reduced) { cards.forEach((c, i) => gsap.set(c, { y: i * STEP })); return; }

    // the deck: card 0 is in place, every next one rides up from below and lands STEP px lower; those under it shrink + dim
    gsap.set(cards, { y: (i) => (i === 0 ? 0 : innerHeight), zIndex: (i) => i + 1, filter: 'brightness(1)' });
    const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
    for (let i = 1; i < N; i++) {
      tl.to(cards[i], { y: i * STEP, duration: 1 }, i - 1);
      for (let j = 0; j < i; j++) tl.to(cards[j], { scale: 1 - (i - j) * 0.05, filter: `brightness(${1 - (i - j) * 0.16})`, duration: 1 }, i - 1);
    }
    ScrollTrigger.create({
      trigger: stage, start: 'top top', end: () => `+=${innerHeight * 0.75 * (N - 1)}`, pin: true, scrub: 0.6, animation: tl, invalidateOnRefresh: true,
    });
    // created after the pin, so its start/end account for the pin spacer
    // photo: rounded card → full-bleed on the way in, back to a card on the way out
    const card = () => (innerWidth < 900 ? 'inset(6% 4% 6% 4% round 28px)' : 'inset(12% 7% 12% 7% round 40px)');
    const open = 'inset(0% 0% 0% 0% round 0px)';
    gsap.fromTo(media, { clipPath: card }, { clipPath: open, ease: 'power1.out', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'top top', scrub: 0.6, invalidateOnRefresh: true } });
    gsap.fromTo(media, { clipPath: open }, { clipPath: card, ease: 'power1.in', immediateRender: false, scrollTrigger: { trigger: sec, start: 'bottom 85%', end: 'bottom top', scrub: 0.6, invalidateOnRefresh: true } });

  });
</script>
