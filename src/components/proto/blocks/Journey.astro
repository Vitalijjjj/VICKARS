---
/** «Шлях вашого авто» — pinned route through four glass stations; the car rides it with the scroll (moved from home). */
const journey = [
  ['Огляд', 'Зустрічаємо, оглядаємо й фотографуємо авто', 'eye', 21, 50],
  ['Мийка', 'Ручна мийка на одному з 6 постів', 'drop', 44, 66],
  ['Лаунж', 'Поки авто миють — ви нагорі, в лаунжі', 'cup', 67, 30],
  ['Видача', 'Майстер перевіряє авто й передає вам', 'key', 89, 50],
] as const;
const icons: Record<string, string> = {
  eye: '<path d="M4 24s7-11 20-11 20 11 20 11-7 11-20 11S4 24 4 24z"/><circle cx="24" cy="24" r="6"/><path d="M34 9l3-4M14 9l-3-4M24 7V3"/>',
  drop: '<path d="M24 5s12 13 12 22a12 12 0 0 1-24 0C12 18 24 5 24 5z"/><path d="M18 29a6 6 0 0 0 6 6"/>',
  cup: '<path d="M9 18h26v9a11 11 0 0 1-11 11h-4A11 11 0 0 1 9 27z"/><path d="M35 21h3a4 4 0 0 1 0 8h-4M16 7c-2 3 2 5 0 8M23 7c-2 3 2 5 0 8M30 7c-2 3 2 5 0 8M6 43h36"/>',
  key: '<circle cx="15" cy="24" r="8"/><path d="M23 24h20m-6 0v6m-6-6v4"/><circle cx="15" cy="24" r="2.5"/>',
};
---

  <!-- ============================================================ 2 · journey of the car: pinned; a car rides one straight
       track through four glass stations, each lights up as the car arrives (scroll-driven) -->
  <section class="dl-journey" id="process" data-bg="#1d1815" data-theme="dark" data-journey>
    <div class="dl-journey__stage">
      <div class="dl-journey__media" aria-hidden="true">
        <!-- Kling 3.0 from the branded still (materials/working/journey-video), played forward + reversed = seamless 10 s loop -->
        <video class="dl-journey__bg" src="/media/journey-wash-v1.mp4" poster="/media/journey-wash-v1-poster.webp" muted loop playsinline preload="metadata" disablepictureinpicture data-journey-bg></video>
      </div>
      <div class="dl-journey__in">
        <div class="dl-journey__head">
          <h2 class="dl-display dl-display--m" data-lines><span class="ln"><span><small>Шлях</small> вашого авто</span></span></h2>
        </div>
        <div class="dl-track" data-track>
          <svg class="dl-route" aria-hidden="true" data-route><path class="dl-route__rail" data-rail /><path class="dl-route__fill" data-fill /></svg>
          <span class="dl-track__car" aria-hidden="true" data-j-car>
            <svg viewBox="0 0 64 28"><path d="M6 19c0-3 2-5 5-5.6l9-1.7 7-5.2c1.6-1.1 3.4-1.7 5.3-1.7h7.4c2.3 0 4.5.9 6.1 2.6l4.6 4.7 6 1.1c2.6.5 4.6 2.8 4.6 5.5V21c0 1.1-.9 2-2 2h-3.3M14.6 23H8c-1.1 0-2-.9-2-2v-2m19.4 4h18.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="19.5" cy="22.5" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="49" cy="22.5" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          </span>
          <ol class="dl-stops">
            {journey.map(([t, d, ic, x, y], i) => (
              <li class:list={['dl-station', { 'is-up': i === 2 }]} style={`--x:${x}%;--y:${y}%`} data-station>
                <span class="dl-station__ring" data-ring><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[ic]} /></span>
                <span class="dl-station__txt"><b><em>{String(i + 1).padStart(2, '0')}</em><span>{t}</span></b><span>{d}</span></span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

<style>
  /* ---------------------------------------------------------- 2 journey (pinned) */
  .dl-journey { position: relative; }
  .dl-journey__stage { position: relative; height: 100vh; height: 100svh; overflow: hidden; }
  .dl-journey__media { position: absolute; inset: 0; }
  .dl-journey__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dl-journey__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, var(--dk) 0%, rgb(29 24 21 / 0.78) 26%, rgb(29 24 21 / 0.74) 64%, var(--dk) 100%); }
  .dl-journey__in { position: relative; z-index: 2; height: 100%; display: grid; grid-template-rows: auto 1fr; padding: calc(var(--header-h) + 64px) var(--gutter) 72px; }
  .dl-journey__head { display: flex; align-items: flex-end; justify-content: center; position: relative; }

  /* curved route: stations sit on their floor bands; JS draws one smooth path through the ring centres */
  .dl-track { --ring: clamp(80px, 6.2vw, 104px); position: relative; align-self: center; height: clamp(360px, 50vh, 500px); margin: 0 clamp(0px, 3vw, 48px); }
  .dl-route { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .dl-route path { fill: none; stroke-linecap: round; }
  .dl-route__rail { stroke: rgb(244 230 216 / 0.22); stroke-width: 1; stroke-dasharray: 2 7; }
  .dl-route__fill { stroke: var(--accent); stroke-width: 1.6; }
  .dl-track__car { position: absolute; z-index: 1; left: 0; top: 0; width: 44px; height: 26px; margin: -13px 0 0 -22px; display: grid; place-items: center; border-radius: 999px; color: #fff; background: var(--accent); box-shadow: 0 8px 22px rgb(229 37 50 / 0.35); will-change: transform; transition: opacity 0.35s, scale 0.45s var(--ease-spring); }
  .dl-track__car svg { width: 28px; height: 13px; }
  .dl-stops { margin: 0; padding: 0; list-style: none; }
  .dl-station { position: absolute; z-index: 2; left: var(--x); top: var(--y); width: 0; height: 0; }
  .dl-station__ring {
    position: absolute; left: 0; top: 0; translate: -50% -50%;
    display: grid; place-items: center; width: var(--ring); height: var(--ring); border-radius: 50%; color: rgb(244 230 216 / 0.5);
    background: rgb(24 20 18 / 0.62); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
    transition: color 0.6s, box-shadow 0.6s, transform 0.8s var(--ease-spring), background 0.6s;
  }
  .dl-station__ring svg { width: 46%; height: 46%; }
  .dl-station__ring :global(svg > *) { stroke-dasharray: 1; stroke-dashoffset: 0; }
  .dl-station__txt { position: absolute; left: 0; top: calc(var(--ring) / 2 + 16px); translate: -50% 0; width: 24ch; display: grid; gap: 6px; text-align: center; opacity: 0.6; transform: translateY(8px); transition: opacity 0.6s, transform 0.8s var(--ease-out); }
  .dl-station__txt b { font-size: clamp(17px, 15px + 0.4vw, 20px); font-weight: 500; letter-spacing: -0.02em; }
  .dl-station__txt b > span, .dl-station__txt > span { opacity: 0; transition: opacity 0.5s; }
  .dl-station.is-on .dl-station__txt b > span, .dl-station.is-on .dl-station__txt > span { opacity: 1; }
  .dl-station__txt em { font-style: italic; font-weight: 200; font-size: 1.3em; color: var(--cream-2); margin-right: 8px; letter-spacing: -0.03em; transition: color 0.5s; }
  .dl-station.is-on .dl-station__txt em, .dl-station.is-done .dl-station__txt em { color: var(--accent); }
  .dl-station__txt span { font-size: 15px; line-height: 1.45; color: var(--cream-2); }
  .dl-station.is-up .dl-station__txt { top: auto; bottom: calc(var(--ring) / 2 + 18px); }
  .dl-station.is-done .dl-station__ring { color: var(--cream); box-shadow: inset 0 0 0 1px rgb(229 37 50 / 0.45); }
  .dl-station.is-on .dl-station__ring { color: #fff; transform: scale(1.12); background: rgb(24 20 18 / 0.75); box-shadow: inset 0 0 0 1.5px var(--accent), 0 0 0 8px rgb(229 37 50 / 0.08); }
  .dl-station.is-on .dl-station__ring :global(svg > *) { animation: dl-draw 1.1s var(--ease-out) both; }
  .dl-station.is-on .dl-station__txt, .dl-station.is-done .dl-station__txt { opacity: 1; transform: none; }
  @keyframes dl-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  @media (max-width: 900px) {
    /* vertical track: rail runs down through the ring centres */
    .dl-journey__in { padding-top: calc(var(--header-h) + 40px); padding-bottom: 32px; }
    /* phones: the route snakes down; rings alternate sides, text sits next to each ring */
    .dl-track { --ring: 72px; height: 62svh; margin: 0; }
    .dl-station.is-up .dl-station__txt { top: 0; bottom: auto; }
    .dl-station:nth-child(1) { --x: 16% !important; --y: 8% !important; }
    .dl-station:nth-child(2) { --x: 84% !important; --y: 35% !important; }
    .dl-station:nth-child(3) { --x: 16% !important; --y: 62% !important; }
    .dl-station:nth-child(4) { --x: 84% !important; --y: 90% !important; }
    .dl-station__txt { top: 0; translate: 0 -50%; width: 52vw; text-align: left; }
    .dl-station:nth-child(odd) .dl-station__txt { left: calc(var(--ring) / 2 + 16px); }
    .dl-station:nth-child(even) .dl-station__txt { left: auto; right: calc(var(--ring) / 2 + 16px); text-align: right; }
    .dl-station__txt span { font-size: 13.5px; }
    .dl-track__car { width: 40px; height: 24px; margin: -12px 0 0 -20px; }
    .dl-track__car svg { width: 26px; height: 12px; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('[data-journey] [data-station]').forEach((st) => st.classList.add('is-done'));
    document.querySelector<HTMLElement>('[data-j-car]')?.style.setProperty('display', 'none');
  } else {
    // journey: pinned; one smooth route through the ring centres, the car rides it and dwells at each station
    const jr = document.querySelector<HTMLElement>('[data-journey]');
    if (jr) {
      const track = jr.querySelector<HTMLElement>('[data-track]')!;
      const stations = Array.from(jr.querySelectorAll<HTMLElement>('[data-station]')), car = jr.querySelector<HTMLElement>('[data-j-car]')!;
      const svg = jr.querySelector<SVGSVGElement>('[data-route]')!, rail = jr.querySelector<SVGPathElement>('[data-rail]')!, fill = jr.querySelector<SVGPathElement>('[data-fill]')!;
      jr.querySelectorAll('.dl-station__ring svg > *').forEach((el) => el.setAttribute('pathLength', '1'));
      const narrow = () => window.matchMedia('(max-width: 900px)').matches;
      let total = 0, stops: number[] = [];
      const build = () => {
        const tr = track.getBoundingClientRect();
        svg.setAttribute('viewBox', `0 0 ${tr.width} ${tr.height}`);
        const pts = stations.map((st) => { const r = st.getBoundingClientRect(); return { x: r.left - tr.left, y: r.top - tr.top }; });
        const v = narrow();
        // tangents run along the flow (horizontal on desktop, vertical on phones) so the line meets every ring dead-centre
        let d = v ? `M ${pts[0].x} ${pts[0].y - 60}` : `M ${-tr.left + 0} ${pts[0].y}`;
        d += ` L ${pts[0].x} ${pts[0].y}`;
        const segs: string[] = [];
        for (let i = 1; i < pts.length; i++) {
          const a = pts[i - 1], b = pts[i], k = 0.55;
          const c = v ? `C ${a.x} ${a.y + (b.y - a.y) * k} ${b.x} ${b.y - (b.y - a.y) * k} ${b.x} ${b.y}` : `C ${a.x + (b.x - a.x) * k} ${a.y} ${b.x - (b.x - a.x) * k} ${b.y} ${b.x} ${b.y}`;
          segs.push(c); d += ' ' + c;
        }
        const lead = v ? 0 : pts[0].x + tr.left;
        rail.setAttribute('d', d + (v ? '' : ` L ${tr.width + (window.innerWidth - tr.right)} ${pts[pts.length - 1].y}`));
        fill.setAttribute('d', `M ${pts[0].x} ${pts[0].y} ` + segs.join(' '));
        total = fill.getTotalLength();
        // cumulative length at every station
        const tmp = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        svg.append(tmp); stops = [0];
        let acc = `M ${pts[0].x} ${pts[0].y}`;
        segs.forEach((c) => { acc += ' ' + c; tmp.setAttribute('d', acc); stops.push(tmp.getTotalLength()); });
        tmp.remove();
        fill.style.strokeDasharray = `${total} ${total}`;
        void lead;
      };
      // progress → length along the route, dwelling at each station
      const N = stations.length, dwell = 0.08;
      const lenAt = (p: number) => {
        const span = (1 - dwell * N) / (N - 1);
        let t = p;
        for (let i = 0; i < N; i++) {
          if (t <= dwell) return { L: stops[i], at: i };
          t -= dwell;
          if (i < N - 1) { if (t <= span) { const f = t / span, e = f < 0.5 ? 2 * f * f : 1 - (-2 * f + 2) ** 2 / 2; return { L: stops[i] + (stops[i + 1] - stops[i]) * e, at: -1 }; } t -= span; }
        }
        return { L: stops[N - 1], at: N - 1 };
      };
      let last = 0;
      const render = (p: number) => {
        last = p;
        if (!total) return;
        const { L, at } = lenAt(p);
        fill.style.strokeDashoffset = String(total - L);
        const a = fill.getPointAtLength(L), b = fill.getPointAtLength(Math.min(total, L + 1)), b0 = fill.getPointAtLength(Math.max(0, L - 1));
        const ang = Math.atan2(b.y - b0.y, b.x - b0.x) * 180 / Math.PI;
        car.style.transform = `translate(${a.x}px, ${a.y}px) rotate(${narrow() ? ang - 90 : ang}deg)`;
        car.style.opacity = at >= 0 ? '0' : '1';
        car.style.scale = at >= 0 ? '0.6' : '1';
        stations.forEach((st, i) => { st.classList.toggle('is-on', i === at); st.classList.toggle('is-done', L >= stops[i] - 0.5 && i !== at); });
      };
      build(); render(0);
      ScrollTrigger.create({ trigger: jr, start: 'top top', end: () => `+=${window.innerHeight * (narrow() ? 1.8 : 2.4)}`, pin: jr.querySelector('.dl-journey__stage'), scrub: true, invalidateOnRefresh: true, onRefresh: () => { build(); render(last); }, onUpdate: (st) => render(st.progress) });
      // background video plays only while the block is on screen
      const vid = jr.querySelector<HTMLVideoElement>('video[data-journey-bg]');
      if (vid) new IntersectionObserver(([e]) => { if (e.isIntersecting) vid.play().catch(() => {}); else vid.pause(); }).observe(jr);
      gsap.fromTo(jr.querySelector('[data-journey-bg]'), { scale: 1.15 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: jr, start: 'top bottom', end: () => `+=${window.innerHeight * 3.4}`, scrub: true } });
    }
  }
</script>
